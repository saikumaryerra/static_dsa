---
/**
 * DifficultyChip — static difficulty label (design §6.5, site spec §9).
 *
 * Props:
 * - `difficulty` "beginner" | "intermediate" — the WORD is the signal, so the
 *   chip stays neutral (no `--hl-*` hue spent; those are reserved for the viz).
 *
 * Neutral pill: surface fill, 1px border, uppercase --text-xs, muted text.
 */
interface Props {
  difficulty: 'beginner' | 'intermediate';
}

const { difficulty } = Astro.props;
const label = difficulty[0]!.toUpperCase() + difficulty.slice(1);
---

<span class="difficulty-chip">{label}</span>

<style>
  .difficulty-chip {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    background-color: var(--surface);
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
</style>
