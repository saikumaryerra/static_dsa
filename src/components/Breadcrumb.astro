---
/**
 * Breadcrumb — static context nav (design §6.1, site spec §9).
 *
 * Props:
 * - `track` the lesson's `Track`; rendered as the label `src/lib/tracks.ts` owns,
 *   linking to that track's section on /learn.
 * - `title` the current lesson title (last crumb; plain text, `aria-current`).
 *
 * Inline `Learn / Track / Lesson`, muted, wraps (never truncates) for long/i18n
 * titles. Every crumb but the last is a link (M7.1 IA-6): the track crumb
 * targets `/learn#track-{track}`, the anchor the /learn index puts on each
 * track section heading and the home track cards already link to.
 */
import { trackLabel, type Track } from '../lib/tracks';

interface Props {
  track: Track;
  title: string;
}

const { track, title } = Astro.props;
const label = trackLabel(track);
---

<nav aria-label="Breadcrumb" class="breadcrumb">
  <ol>
    <li><a href="/learn">Learn</a></li>
    <li aria-hidden="true" class="sep">/</li>
    <li><a href={`/learn#track-${track}`}>{label}</a></li>
    <li aria-hidden="true" class="sep">/</li>
    <li><span aria-current="page">{title}</span></li>
  </ol>
</nav>

<style>
  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .breadcrumb a {
    color: var(--text-muted);
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .breadcrumb a:hover {
    color: var(--text);
  }

  .breadcrumb [aria-current='page'] {
    color: var(--text);
  }

  .sep {
    color: var(--text-muted);
  }
</style>
