---
/**
 * Callout — static note/tip/warning box (design §6.7, site spec §9).
 *
 * Props:
 * - `variant` "note" | "tip" | "warning" (default "note").
 *
 * Meaning is never color-only: every callout shows a 16px icon AND a bold label.
 * To keep the palette calm (saturated color reserved for the viz), accents stay
 * in-system — Note/Tip use `--brand`; Warning uses `--border-strong` + a warning
 * triangle (icon + word carry the semantics; no red token introduced). Body
 * prose goes in the default slot.
 */
type Variant = 'note' | 'tip' | 'warning';

interface Props {
  variant?: Variant;
}

const { variant = 'note' } = Astro.props;

const labels: Record<Variant, string> = {
  note: 'Note',
  tip: 'Tip',
  warning: 'Warning',
};

// Stroke icon paths (24×24), house style.
const icons: Record<Variant, string[]> = {
  note: ['M12 16v-4', 'M12 8h.01', 'M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z'],
  tip: [
    'M9 18h6',
    'M10 22h4',
    'M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.2 1 2h6c0-.8.4-1.5 1-2A7 7 0 0 0 12 2z',
  ],
  warning: ['M12 3 2 20h20z', 'M12 10v4', 'M12 17h.01'],
};
---

<aside class:list={['callout', `callout--${variant}`]} role="note">
  <div class="callout__head">
    <svg
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      {icons[variant].map((d) => <path d={d} />)}
    </svg>
    <span class="callout__label">{labels[variant]}</span>
  </div>
  <div class="callout__body">
    <slot />
  </div>
</aside>

<style>
  .callout {
    background-color: var(--surface);
    border-radius: var(--radius-card);
    border-left: 4px solid var(--brand);
    padding: var(--space-4);
  }

  .callout--warning {
    border-left-color: var(--border-strong);
  }

  .callout__head {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--brand);
    margin-bottom: var(--space-2);
  }

  .callout--warning .callout__head {
    color: var(--text);
  }

  .callout__label {
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
  }

  .callout__body {
    color: var(--text);
    max-width: var(--measure);
  }

  .callout__body :global(:first-child) {
    margin-top: 0;
  }

  .callout__body :global(:last-child) {
    margin-bottom: 0;
  }
</style>
