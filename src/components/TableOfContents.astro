---
/**
 * TableOfContents — in-lesson section nav from rendered headings (design §1.3, §9).
 *
 * Props:
 * - `headings` Astro's `MarkdownHeading[]` (`{ depth, slug, text }`); only h2
 *   (depth 2) is shown — the 7 lesson sections.
 * - `variant`  "inline" (a sticky mini-ToC below 1024px) or "rail" (≥1024 sticky nav).
 *
 * Links are plain in-page anchors — fully functional with JS off. Active-section
 * highlighting and the collapsed bar's section name are progressive enhancements
 * wired by LessonLayout's script (`data-toc-link`, `data-toc-current`); the list
 * is fully usable without either.
 *
 * M7.2: the inline variant is promoted from a plain in-flow `<details>` to a bar
 * that sticks under the site header, so wayfinding survives a 7,000px lesson on
 * a phone. It stays a NATIVE `<details>` (zero JS to open/close), and its open
 * list is absolutely positioned so expanding it never pushes the article down.
 *
 * M7.3: the current entry gains a `--brand-soft` tint on top of its brand bar,
 * and the inline panel fades in and out instead of popping. Both are decoration
 * layered over cues that already carry the meaning — see the stylesheet notes.
 */
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  variant: 'inline' | 'rail';
}

const { headings, variant } = Astro.props;
const items = headings.filter((h) => h.depth === 2);
---

{
  variant === 'inline' ? (
    <details class="toc toc--inline" data-toc-inline>
      <summary>
        <svg
          class="toc__chevron"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M9 6l6 6-6 6" />
        </svg>
        <span>On this page</span>
        {/* Filled by the scroll-spy. NOT aria-hidden: it is visible text inside
            the summary's label, and hiding it from the accessible name while
            showing it on screen is exactly what WCAG 2.5.3 forbids. */}
        <span class="toc__current" data-toc-current />
      </summary>
      <nav class="toc__panel" aria-label="On this page">
        <ol>
          {items.map((h) => (
            <li>
              <a href={`#${h.slug}`} data-toc-link={`#${h.slug}`}>
                {h.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </details>
  ) : (
    <nav class="toc toc--rail" aria-label="On this page">
      <p class="toc__label">On this page</p>
      <ol>
        {items.map((h) => (
          <li>
            <a href={`#${h.slug}`} data-toc-link={`#${h.slug}`}>
              {h.text}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--text-sm);
  }

  .toc a {
    display: block;
    padding-block: var(--space-1-5);
    padding-inline: var(--space-3) var(--space-2);
    border-left: 2px solid transparent;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    color: var(--text-muted);
    transition:
      color var(--duration-fast) var(--ease-standard),
      background-color var(--duration-fast) var(--ease-standard);
  }

  .toc a:hover {
    color: var(--text);
  }

  /* M7.3: the current section gets the brand TINT as well as the brand bar, so
     "you are here" is a shape the eye lands on rather than a 2px edge. The bar
     and `aria-current` are the non-color cues and both stay — the fill is the
     reinforcement, never the signal. `--text` on `--brand-soft` is 14.86:1 light
     / 12.90:1 dark; the tint itself is quiet against what it sits on (1.20:1 on
     the rail's `--bg`, 1.23:1 on the inline panel's `--surface`, and 1.26:1 /
     1.16:1 for the same two in dark), which is precisely why it may not carry
     meaning alone. It used to be luminance-IDENTICAL to `--surface` in dark;
     that stopped being true when Plan B moved dark `--brand-soft` off the bluest
     step in the ramp, and the tint is now a hair darker than the panel rather
     than exactly equal to it. Still decorative either way. */
  .toc a[aria-current='location'] {
    color: var(--text);
    border-left-color: var(--brand);
    background-color: var(--brand-soft);
  }

  /* ---- Inline form: the sticky mini-ToC bar below 1024px (M7.2) ---- */
  .toc--inline {
    display: block;
    position: sticky;
    /* Directly under the header — no gap, or the article shows through it. */
    top: var(--header-h);
    /* Below the site header (z-40), above the article it covers. */
    z-index: 30;
    margin-bottom: var(--space-2);
    background-color: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  .toc--inline summary {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    /* --toc-bar-h is declared on .lesson (global.css): the heading
       scroll-margin-top has to know this bar's height, and two scoped
       stylesheets cannot otherwise share a value. */
    min-height: var(--toc-bar-h);
    padding-block: var(--space-2);
    cursor: pointer;
    color: var(--text);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    list-style: none;
  }

  .toc--inline summary::-webkit-details-marker {
    display: none;
  }

  .toc__chevron {
    color: var(--text-muted);
    transition: transform var(--duration-base) var(--ease-standard);
  }

  .toc--inline[open] .toc__chevron {
    transform: rotate(90deg);
  }

  /* The section you are in, right-aligned in the collapsed bar. Truncates
     rather than wraps so the bar's height never changes as you scroll. */
  .toc__current {
    margin-left: auto;
    max-width: 55%;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: var(--text-muted);
    font-weight: var(--weight-normal);
  }

  /* Absolutely positioned (M7.2): opening the ToC must not shift the article
     under the reader's finger. The bar itself is `position: sticky`, which is a
     positioned ancestor, so this anchors to the bar. */
  .toc__panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    max-height: min(60svh, 24rem);
    overflow-y: auto;
    padding: var(--space-2) var(--space-2) var(--space-3);
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0 0 var(--radius-card) var(--radius-card);
    box-shadow: var(--shadow-2);
  }

  /* CMP-13 in its inline form: the panel fades instead of popping. Same
     mechanism as `Collapsible` — `::details-content` + `allow-discrete`, the
     same `--duration-slow`, and the same "an engine without the pseudo-element
     drops the whole ruleset and keeps today's instant open" fallback — but a
     DIFFERENT animated property, deliberately. `.toc__panel` is absolutely
     positioned so that opening the bar shifts no article text (M7.2), so it
     contributes no height whatsoever and `block-size: 0 -> auto` would
     interpolate between two zeroes here. Opacity is the pair of endpoints that
     actually exists. Nothing clips it for the same reason: the panel's
     containing block is the sticky <details>, an ancestor of the pseudo. */
  /* The two directions get DIFFERENT transitions, deliberately — a transition
     declared on a state applies when moving TO that state.

     Closing (base rule) animates `content-visibility` with `allow-discrete`, so
     the panel stays rendered for the length of the fade instead of vanishing
     mid-way.

     Opening (the `[open]` rule) animates opacity ONLY. Including
     `content-visibility` here would keep the subtree skipped for the first frame
     of the fade, and a skipped subtree is not focusable: a keyboard user who
     opened the panel and pressed Tab was thrown PAST the navigation they had
     just opened (measured: `content-visibility: hidden` at 0ms, `visible` by
     50ms). Navigation has to be operable the instant it opens; the fade is only
     polish, and this keeps it without buying it at the cost of focus order. */
  .toc--inline::details-content {
    opacity: 0;
    transition:
      content-visibility var(--duration-slow) allow-discrete,
      opacity var(--duration-slow) var(--ease-standard);
  }

  .toc--inline[open]::details-content {
    opacity: 1;
    transition: opacity var(--duration-slow) var(--ease-standard);
  }

  /* `allow-discrete` keeps the closing panel rendered for the length of the
     fade, which would otherwise leave it tappable while it is invisible — a
     stray tap on a link the reader can no longer see. Set on the panel itself,
     not on the pseudo-element: inheritance runs down the DOM tree and never
     passes through ::details-content. */
  .toc--inline:not([open]) .toc__panel {
    pointer-events: none;
  }

  /* ---- Rail (desktop) form ---- */
  .toc--rail {
    display: none;
    position: sticky;
    top: calc(var(--header-h) + var(--space-6));
    max-height: calc(100svh - var(--header-h) - var(--space-12));
    overflow-y: auto;
  }

  .toc__label {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    margin-bottom: var(--space-2);
  }

  @media (min-width: 1024px) {
    .toc--inline {
      display: none;
    }

    .toc--rail {
      display: block;
    }
  }
</style>
