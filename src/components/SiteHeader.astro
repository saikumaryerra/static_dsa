---
/**
 * SiteHeader — global sticky header (site spec §9, designer M1 wireframe).
 *
 * Props: none. Marks the link matching the current URL with `aria-current="page"`
 * and the section a descendant page sits under with `aria-current="true"`.
 *
 * Layout per wireframe: sticky top, z-40, `--header-h` tall (56px, 64px ≥768px),
 * bg --bg with a 1px --border bottom rule; wordmark left, nav (Learn / Glossary /
 * About) + theme toggle right. Labels flex-wrap instead of truncating (i18n
 * headroom). The height comes from the token and is stated nowhere else here —
 * see the style block below.
 */
import ThemeToggle from './ThemeToggle.astro';
import { NAV_ITEMS, navCurrent } from '../lib/nav';

// The matching rule moved to `nav.ts` in D1. `NAV_ITEMS` now carries the shipped
// trailing-slash href, so BOTH sides of the comparison have to be normalized —
// and normalization that lives beside the hrefs it normalizes cannot drift from
// them. It is also the only shape the rule can be a Vitest test in: this
// frontmatter is not importable and the harness has no DOM. Dev, preview and the
// build all hand it the slashed pathname now (measured), so what its `.html`
// strip still buys is `/learn/index.html` — a URL a directory build genuinely
// serves — plus the retired `format: 'file'` shape.
---

<header class="site-header sticky top-0 z-40 border-b border-border bg-bg">
  <div class="flex h-full items-center justify-between gap-4 px-4 md:px-6">
    {
      /* `data-site-root` is load-bearing, not a test hook (Plan D §4.2, R3).
         `scripts/portablize.mjs` rewrites this href per page depth — `./` here,
         `../../` on a lesson — so it is the one link on every document that
         resolves to the deployment's own root whether the site is served at
         `learndsa.dev` or inside `sample.com/learndsa/`. The three islands that
         BUILD a link in client JS resolve it against this anchor (`siteRoot` in
         `src/lib/progress.ts`), because a post-build HTML pass cannot reach a
         template literal inside a chunk. The build asserts the anchor is on
         every page; moving it means giving the new home the attribute. */
    }
    <a href="/" data-site-root class="text-lg font-bold text-text">LearnDSA</a>
    <nav aria-label="Main" class="site-nav">
      <ul class="flex flex-wrap items-center gap-5">
        {
          NAV_ITEMS.map((item) => (
            <li>
              <a
                href={item.href}
                class="nav-link"
                aria-current={navCurrent(Astro.url.pathname, item.href)}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <ThemeToggle />
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  /* The header CONSUMES --header-h rather than restating it (M7.2 review): the
     token used to be a hand-maintained mirror of `h-14 md:h-16` here, so editing
     this file moved the chrome and silently left six sticky offsets and
     scroll-margins behind in four other files.

     On the <header>, not the inner bar, because --header-h is defined as the
     BORDER-BOX height: box-sizing is border-box site-wide (Tailwind preflight),
     so the 1px keyline sits inside the token's value and `top: var(--header-h)`
     now lands flush on the rule instead of 1px under it. The bar takes h-full. */
  .site-header {
    height: var(--header-h);
  }
</style>
