---
/**
 * Figure — the frame every diagram in this site is drawn inside (course
 * expansion, `docs/courses/SPEC.md` Phase 4, decision D-08).
 *
 * The site had no diagram mechanism at all: no Mermaid, no `<Figure>`, no
 * content SVG, and no styling for raster media. `renderStatic()` exists but is
 * bound to an instrumented algorithm's `Step[]`, so it cannot draw a control
 * plane. Of the
 * three options the spec ranks, hand-written inline SVG is the only one that is
 * zero-dependency, zero-JS, follows the light/dark tokens and prints — a static
 * `.svg` asset cannot repaint itself for the theme, and Mermaid means either a
 * large client bundle against the 60 KB budget or a headless browser in the
 * build.
 *
 * **This component owns the `<svg>` element**, and a diagram supplies only its
 * children. That is deliberate: the accessible name and description are then
 * structural rather than something each of eleven diagrams has to remember, and
 * `role="img"` plus the id wiring cannot drift between them.
 *
 * Props:
 * - `viewBox`   the SVG user-space box, e.g. `"0 0 640 360"`. Keep the numbers
 *               small — they are also the font sizes, and a 1600-wide box makes
 *               every label half-size on a phone.
 * - `title`     the accessible NAME. One short noun phrase.
 * - `description` the accessible DESCRIPTION: what the diagram actually shows,
 *               in enough detail that a reader who cannot see it loses nothing.
 * - `caption`   the visible caption under the frame. Never a restatement of the
 *               title — it says what to take away.
 * - `id`        optional anchor id, so prose can link to a figure.
 * - `minWidth`  px width below which the frame scrolls instead of shrinking.
 *
 * WHY IT DOES NOT SCALE UP EITHER. The viewBox width is also the drawing's
 * natural size, and letting `width: 100%` stretch a 690-unit diagram across a
 * 1118px column renders its 14px labels at 23px — larger than the lesson's own
 * headings, which reads as a mistake rather than as emphasis. The frame caps the
 * drawing at 1:1 so a diagram's type is the same size as the prose beside it.
 *
 * WHY IT SCROLLS RATHER THAN SHRINKS. A diagram scaled to 343px of a phone
 * screen renders its labels at around 6px. Spec §6 allows a diagram to scroll
 * ("no horizontal overflow unless intentional and handled — scrollable code
 * blocks and tables, for example"), so the frame keeps the text legible and
 * lets the box scroll, with `tabindex="0"` so the scroll region is reachable
 * from the keyboard (WCAG 2.1.1, and axe's `scrollable-region-focusable`).
 *
 * THE DRAWING KIT. Every shape class a diagram may use is defined here, in
 * tokens, so no diagram hardcodes a colour and all eleven look like one set.
 * Arrowheads are drawn as `<polygon class="dg-head">` rather than with an SVG
 * `<marker>`: a marker needs a document-unique id, and eleven figures on one
 * page referencing a shared id is either duplicate ids or eleven copies of the
 * same four vertices.
 */
import { nextUid } from './uid';

interface Props {
  viewBox: string;
  title: string;
  description: string;
  caption: string;
  id?: string;
  minWidth?: number;
}

const {
  viewBox,
  title,
  description,
  caption,
  id,
  minWidth = 520,
} = Astro.props;

const uid = `fig-${nextUid()}`;

/**
 * The drawing's natural width in px — the third number of the viewBox. Used as
 * the cap so the SVG never scales past 1:1 (see the note above). A malformed
 * viewBox falls back to no cap rather than to a wrong one.
 */
const naturalWidth = Number(viewBox.trim().split(/\s+/)[2]);
const cap = Number.isFinite(naturalWidth) ? `${naturalWidth}px` : 'none';
---

<figure class="figure" id={id}>
  {
    /* The scroll container carries `tabindex` and NOTHING else: a `role="group"`
       here with the same `aria-labelledby` as the `<svg>` inside it makes a
       screen reader announce the diagram's name twice, once for the wrapper and
       once for the image. Focusability is all WCAG 2.1.1 asks of a scroll
       region, and it is all axe checks. */
  }
  <div class="figure__frame" tabindex="0">
    <svg
      class="figure__svg"
      viewBox={viewBox}
      role="img"
      aria-labelledby={`${uid}-t`}
      aria-describedby={`${uid}-d`}
      style={`min-width:${minWidth}px;max-width:${cap}`}
    >
      <title id={`${uid}-t`}>{title}</title>
      <desc id={`${uid}-d`}>{description}</desc>
      <slot />
    </svg>
  </div>
  <figcaption class="figure__caption">{caption}</figcaption>
</figure>

<style>
  .figure {
    margin-block: var(--space-8);
  }

  .figure__frame {
    overflow-x: auto;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: var(--space-4);
  }

  .figure__svg {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--font-sans);
  }

  .figure__caption {
    margin-block-start: var(--space-3);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--text-muted);
    max-width: var(--measure);
  }

  /* ---- The drawing kit. `:global` because the shapes arrive through the slot,
     which Astro does not scope to this component. Every value is a token, so a
     diagram never states a colour and both themes come free. ---- */

  /* A box: the default resting shape. */
  .figure :global(.dg-box) {
    fill: var(--surface-sunken);
    stroke: var(--border-strong);
    stroke-width: 1.5;
    rx: 6;
  }

  /* The one box a diagram wants the eye to land on first. One per figure. */
  /* The palette is achromatic by design (`--brand` is byte-identical to
     `--text`), so a "highlight" fill is a barely-there half-step. The emphasis
     is carried by the STROKE instead — darker and thicker — which also survives
     forced colours and greyscale printing, where a fill difference does not. */
  .figure :global(.dg-box--accent) {
    fill: var(--brand-soft);
    stroke: var(--text);
    stroke-width: 2.5;
  }

  /* A dashed container drawn AROUND a group of boxes (a node, a region, a VPC).

     `--border-strong`, not `--border`. tokens.css annotates the two: `--border`
     is "decorative separators only" at 1.36:1 on `--surface`, `--border-strong`
     is "input borders, meaningful icons (>=3:1)" at 4.05:1. A group boundary is
     the opposite of decorative — in the upload pipeline it is the line between
     a video that is watchable and one that is not — so WCAG 1.4.11's 3:1 floor
     for meaning-carrying non-text applies to it. axe cannot see this: it does
     not evaluate SVG stroke contrast, so a green scan says nothing about it.
     What keeps a group distinguishable from a connector is the DASH, not the
     colour. */
  .figure :global(.dg-group) {
    fill: none;
    stroke: var(--border-strong);
    stroke-width: 1.5;
    stroke-dasharray: 5 4;
    rx: 8;
  }

  /* Connectors. `.dg-line--soft` is for a relationship that is weaker than the
     main flow — a watch, a read-through, an optional path — and is dashed so it
     is distinguishable without colour (§12: never colour alone). */
  .figure :global(.dg-line) {
    fill: none;
    stroke: var(--border-strong);
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  /* A FINER dash than `.dg-group`'s 5 4, deliberately. The two shared a stroke
     colour and a dash pattern, so a soft connector running parallel to a region
     border twenty units away was drawn with an identical signature and read as a
     second, mis-drawn group rectangle — found by looking at a 6x zoom, not by
     any geometric check, because nothing overlapped. A border encloses and a
     connector travels; they should not look the same. */
  .figure :global(.dg-line--soft) {
    /* Weaker than the main flow, and said with the dash rather than with the
       contrast — a read-through the reader cannot see is not a weaker
       relationship, it is a missing one. Same 1.4.11 reasoning as `.dg-group`. */
    stroke: var(--border-strong);
    stroke-dasharray: 2 3;
  }

  .figure :global(.dg-head) {
    fill: var(--border-strong);
    stroke: none;
  }

  .figure :global(.dg-head--soft) {
    /* The arrowhead of a soft connector. It carries the connector's DIRECTION,
       which is the one thing a dash cannot say. */
    fill: var(--border-strong);
  }

  /* Text. Sizes are viewBox units, so keep boxes small (see the `viewBox` prop). */
  .figure :global(.dg-label) {
    fill: var(--text);
    font-size: 14px;
    font-weight: 600;
  }

  .figure :global(.dg-sub) {
    fill: var(--text-muted);
    font-size: 12px;
  }

  .figure :global(.dg-mono) {
    font-family: var(--font-mono);
    fill: var(--text-muted);
    font-size: 11.5px;
  }

  /* A caption INSIDE the drawing — a region name over a dashed group. */
  .figure :global(.dg-legend) {
    fill: var(--text-muted);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* Forced colours: the site's convention is to re-encode state on channels the
     mode preserves rather than to opt out with `forced-color-adjust`. Fills all
     collapse to the system canvas there, so the shapes are told apart by their
     stroke — which is why `.dg-group` and `.dg-line--soft` are dashed by design
     rather than by decoration, and why the accent box takes a thicker one. */
  @media (forced-colors: active) {
    .figure :global(.dg-box),
    .figure :global(.dg-group) {
      fill: Canvas;
      stroke: CanvasText;
    }

    .figure :global(.dg-box--accent) {
      stroke-width: 3;
    }

    .figure :global(.dg-line),
    .figure :global(.dg-line--soft) {
      stroke: CanvasText;
    }

    .figure :global(.dg-head),
    .figure :global(.dg-head--soft) {
      fill: CanvasText;
    }

    .figure :global(.dg-label),
    .figure :global(.dg-sub),
    .figure :global(.dg-mono),
    .figure :global(.dg-legend) {
      fill: CanvasText;
    }
  }
</style>
