---
/**
 * LessonCard — one curriculum-index item (site spec §8, §9 component inventory).
 *
 * Props:
 * - `slug`             lesson slug; the whole card links to `/learn/{slug}` and
 *                      keys the progress reflect — the completion mark
 *                      (`lesson:{slug}:complete`) and the M8 mastery record
 *                      behind the pips.
 * - `order`            the lesson's global order number (§7 frontmatter).
 * - `title`            lesson title (rendered as the card heading).
 * - `summary`          one-line summary (§8).
 * - `difficulty`       "beginner" | "intermediate" — passed to DifficultyChip.
 * - `estimatedMinutes` reading estimate (§8).
 * - `headingLevel`     "h3" (default) so the card heading nests under the index's
 *                      section h2; overridable if a page's heading order differs.
 *
 * The whole card is a single `<a>` (only non-interactive content inside, so it
 * stays a valid link). Its progress state is hidden by default and revealed only
 * when the index page's progress island resolves a stage from localStorage — so
 * with JS off nothing shows and the card is fully usable (spec §6 local
 * "completed" state, §12 a11y).
 *
 * M8.1 — the done-checkmark becomes the three MASTERY PIPS. The check glyph is
 * unchanged, it is now pip 1's fill, so "checked off" still means what it meant
 * in M7 and the other two pips extend the same row (design in
 * `docs/m8-gamification.md`).
 *
 * // SPEC-GAP (§8): §8's M8 amendment names this swap ("the done-checkmark
 * becomes the first of three mastery pips") but does not say what the card's
 * sr-only STATUS TEXT becomes. It now carries the stage word ("Practiced")
 * rather than the fixed "Completed", because mastery states are the only
 * progress currency the product has. The text stays inside the link as CONTENT:
 * an `aria-label` on the `<a>` would REPLACE the card's accessible name and hide
 * the title and summary from screen-reader users — the whole card is the link,
 * so its content is its name.
 *
 * M7.3 CMP-1: the card said "link" to nobody — hover moved a 1px border and
 * nothing else, there was no pressed state, and the home track cards carried a
 * "→" convention these 15 contradicted. It now COMPOSES `.track-card`
 * (global.css) instead of restating a lookalike recipe, so the elevation model's
 * level 1 → 2 → pressed steps are defined once for both card families and cannot
 * drift again, and it ends with the same explicit "Start lesson →" affordance.
 */
import DifficultyChip from './DifficultyChip.astro';
import MasteryPips from './MasteryPips.astro';
import { PIPS_KILL_SWITCH } from '../lib/mastery-ui';

interface Props {
  slug: string;
  order: number;
  title: string;
  summary: string;
  difficulty: 'beginner' | 'intermediate';
  estimatedMinutes: number;
  headingLevel?: 'h2' | 'h3';
}

const {
  slug,
  order,
  title,
  summary,
  difficulty,
  estimatedMinutes,
  headingLevel = 'h3',
} = Astro.props;

const Heading = headingLevel;
---

<a
  href={`/learn/${slug}`}
  class="track-card lesson-card"
  data-lesson-card
  data-slug={slug}
>
  <div class="lesson-card__top">
    <span class="lesson-card__order" aria-hidden="true">
      {String(order).padStart(2, '0')}
    </span>
    <DifficultyChip difficulty={difficulty} />
    {
      /* The wrapper is always in the DOM and always empty-width until the pips
         appear, so `margin-left: auto` right-aligns the stage from first paint
         and hydration cannot shift the row. `killSwitch={false}`: the identical
         rule is emitted below, OUTSIDE the link — a `<style>` belongs nowhere
         inside phrasing content. */
    }
    <span class="lesson-card__stage">
      <MasteryPips slug={slug} labelHidden killSwitch={false} />
    </span>
  </div>

  <Heading class="lesson-card__title">{title}</Heading>
  <p class="lesson-card__summary">{summary}</p>

  <div class="lesson-card__foot">
    <p class="lesson-card__meta">~{estimatedMinutes} min read</p>
    <span class="lesson-card__cta">
      Start lesson <span aria-hidden="true">→</span>
    </span>
  </div>
</a>

{
  /* MasteryPips' kill-switch, hosted here (and suppressed there) because this
     card renders the pips inside its `<a>`. Same shared rule, so the two can
     never disagree; global selector, so one block covers every card. The pips
     are ALSO hidden by their own `[data-stage]` rule, which no JS-off page can
     satisfy — this is the belt-and-braces half every M8 component ships. */
}<noscript set:html={PIPS_KILL_SWITCH} />

<style>
  /* Fill, border, radius and the whole elevation ladder (resting --shadow-1;
     hover --surface-raised + --shadow-2 + a --text-muted keyline; pressed back
     to level 1) come from `.track-card` in global.css — deliberately NOT
     restated here. The hover keyline is --text-muted, NOT --border-strong:
     --border-strong on --surface-raised measures 2.64:1 in dark, below the 3:1
     a meaningful boundary owes (M7.3 review). Only the
     column layout and the denser padding a 15-card grid wants are local, and
     both are state-independent: component styles are unlayered and would
     otherwise beat `@layer components`' hover/active rules from the resting
     state. Never declare border-color or box-shadow in this block. */
  .lesson-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--space-5);
  }

  .lesson-card__top {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .lesson-card__order {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  /* The stage sits at the end of the top row, where the done-checkmark did.
     Empty until the progress island paints the pips (JS off = never), and
     `inline-flex` on an empty span is zero-width — so the auto margin holds the
     right edge from first paint and revealing the pips shifts nothing else in
     the row. No colour is set here: each pip takes its own from the stage. */
  .lesson-card__stage {
    display: inline-flex;
    align-items: center;
    margin-left: auto;
  }

  .lesson-card__title {
    margin-top: var(--space-3);
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    color: var(--text);
    transition: color var(--duration-fast) var(--ease-standard);
  }

  /* The title picks up the brand with the card's own hover, so the thing being
     pointed at reads as the link it is. Decorative: the underlying signal is
     that the entire card is one <a>, and the "Start lesson →" line below states
     it in words for anyone who never hovers. */
  .lesson-card:hover .lesson-card__title {
    color: var(--brand);
  }

  .lesson-card__summary {
    margin-top: var(--space-2);
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  /* Push the foot to the bottom so cards of uneven summary length align. It
     wraps rather than shrinks: at 320px with a long localized CTA the two halves
     stack instead of the reading estimate being squeezed to two lines. */
  .lesson-card__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
    margin-top: auto;
    padding-top: var(--space-4);
  }

  .lesson-card__meta {
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }

  /* Matches the `.prevnext__cta` / track-card wording and the home cards' arrow
     convention, so "whole card is a link" is stated the same way everywhere.
     The arrow is a separate aria-hidden span — it is decoration, and it must not
     end up baked into a translated string (design-tokens-m1.md, hero CTA note). */
  .lesson-card__cta {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--brand);
  }
</style>
