---
/**
 * PrevNext — static lesson pagination (design §6.3, site spec §9).
 *
 * Props:
 * - `prev` / `next` — `{ slug, title, trackLabel? }`, or `null` at the ends of
 *   the curriculum (lesson 01 has no prev, the last lesson no next).
 *
 * Each present side is a whole-card link (reuses the `.track-card` treatment).
 * A missing side is omitted entirely (no disabled placeholder), and the present
 * side keeps its column via `justify-content`.
 *
 * `trackLabel` is set by `[slug].astro` only when that neighbour sits in a
 * different track (M7.1 IA-5): the overline then names the track being entered,
 * so the one crossing in the linear path is explicit instead of silent — spec §8
 * requires prev/next to "name the track when it changes".
 */
interface Adjacent {
  slug: string;
  title: string;
  /** Human track name — present ONLY when this neighbour crosses tracks. */
  trackLabel?: string;
}

interface Props {
  prev: Adjacent | null;
  next: Adjacent | null;
}

const { prev, next } = Astro.props;

// Same-track neighbours keep the plain wording; no visual noise on the pairs
// that don't change track.
const prevOverline = prev?.trackLabel
  ? `Previous track: ${prev.trackLabel}`
  : 'Previous';
const nextOverline = next?.trackLabel
  ? `Next track: ${next.trackLabel}`
  : 'Next';
---

<nav aria-label="Lesson navigation" class="prevnext">
  {
    prev && (
      <a href={`/learn/${prev.slug}`} class="track-card prevnext__item">
        <span class="prevnext__overline">
          <span aria-hidden="true">←</span> {prevOverline}
        </span>
        <span class="prevnext__title">{prev.title}</span>
      </a>
    )
  }
  {
    next && (
      <a
        href={`/learn/${next.slug}`}
        class="track-card prevnext__item prevnext__item--next"
      >
        <span class="prevnext__overline">
          {nextOverline} <span aria-hidden="true">→</span>
        </span>
        <span class="prevnext__title">{next.title}</span>
      </a>
    )
  }
</nav>

<style>
  .prevnext {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .prevnext {
      flex-direction: row;
      justify-content: space-between;
    }

    .prevnext__item {
      flex: 1;
      max-width: calc(50% - var(--space-2));
    }
  }

  .prevnext__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
  }

  .prevnext__item--next {
    text-align: right;
    margin-left: auto;
  }

  .prevnext__overline {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .prevnext__title {
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    color: var(--text);
  }
</style>
