---
/**
 * PrevNext — end-of-lesson pagination (design §6.3, site spec §8, §9).
 *
 * Props:
 * - `prev` / `next` — `{ slug, title, trackLabel? }`, or `null` at the ends of
 *   the curriculum (lesson 01 has no prev, the last lesson no next).
 *
 * M7.2 rebalances the pair instead of showing two equal cards: continuing is
 * the action people take, so **Next is the card** (title + "Start lesson →")
 * and **Prev is a text link** below it. The two-equal-cards layout made the
 * end of a lesson a fork with no recommended branch.
 *
 * `next === null` is NOT a dead end (§3): the last lesson still gets a card,
 * pointing back to the curriculum index. Handling it here rather than in
 * `WhatsNext` keeps every card in this file, so the treatment cannot drift.
 *
 * `trackLabel` is set by `[slug].astro` only when that neighbour sits in a
 * different track (M7.1 IA-5): the overline then names the track being entered,
 * so the one crossing in the linear path is explicit instead of silent — spec §8
 * requires prev/next to "name the track when it changes".
 */
interface Adjacent {
  slug: string;
  title: string;
  /** Human track name — present ONLY when this neighbour crosses tracks. */
  trackLabel?: string;
}

interface Props {
  prev: Adjacent | null;
  next: Adjacent | null;
}

const { prev, next } = Astro.props;

// Same-track neighbours keep the plain wording; no visual noise on the pairs
// that don't change track. Prev renders "<overline> · <title>" (the middot is
// aria-hidden, so the link is announced "Previous Recursion") — appending the
// title with a second colon would read "Previous track: Foundations: Graphs".
const prevOverline = prev?.trackLabel
  ? `Previous track: ${prev.trackLabel}`
  : 'Previous';
const nextOverline = next?.trackLabel
  ? `Next track: ${next.trackLabel}`
  : 'Next';
---

<nav aria-label="Lesson navigation" class="prevnext">
  {
    next ? (
      <a href={`/learn/${next.slug}`} class="track-card prevnext__next">
        <span class="prevnext__overline">{nextOverline}</span>
        <span class="prevnext__title">{next.title}</span>
        <span class="prevnext__cta">
          Start lesson <span aria-hidden="true">→</span>
        </span>
      </a>
    ) : (
      <a href="/learn" class="track-card prevnext__next">
        <span class="prevnext__overline">Last lesson</span>
        <span class="prevnext__title">That's the whole curriculum</span>
        <span class="prevnext__cta">
          Back to all lessons <span aria-hidden="true">→</span>
        </span>
      </a>
    )
  }
  {
    prev && (
      <a href={`/learn/${prev.slug}`} class="prevnext__prev">
        <span aria-hidden="true">←</span> {prevOverline}{' '}
        <span aria-hidden="true">·</span> {prev.title}
      </a>
    )
  }
</nav>

<style>
  .prevnext {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  /* The card carries the weight: full width, a lesson-sized title and an
     explicit CTA, matching the affordance of the /learn lesson cards. */
  .prevnext__next {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    max-width: var(--measure);
  }

  .prevnext__overline {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .prevnext__title {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    color: var(--text);
  }

  .prevnext__cta {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--brand);
  }

  /* Demoted to a link, but still a comfortable target: the padding gives it a
     44px-tall hit area without a button's visual weight. */
  .prevnext__prev {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1-5);
    align-self: flex-start;
    padding-block: var(--space-2);
    min-height: 44px;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .prevnext__prev:hover {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
