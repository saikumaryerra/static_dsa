---
/**
 * Curriculum index — `/learn` (site spec §6 site map, §8 layout).
 *
 * Data-driven: queries the published lessons, groups them into the two tracks
 * (Foundations / Algorithms), and sorts each by `order`, so new lessons appear
 * automatically as later M4 batches add `.mdx` files — this page never lists a
 * lesson by hand. Each lesson renders as a `LessonCard`.
 *
 * M7.2 closes the progress loop here (§8 "curriculum index"), all of it driven
 * by `src/lib/progress.ts` reading the same `lesson:{slug}:complete` keys
 * `MarkComplete` writes: a resume CTA under the page head, a per-track
 * "N of M done on this device" counter beside each track heading, a progress
 * mark on each card, and a reset-progress control with an inline confirm step.
 * The lesson list those four surfaces need is injected as JSON at build time
 * (`data-lessons`) — localStorage is never enumerated by prefix.
 *
 * M8.1 draws the same two surfaces in the one progress currency (spec §8's M8
 * amendment; `docs/m8-gamification.md`), without adding a store or a script:
 * the card's done-checkmark becomes `MasteryPips` (the check is pip 1), and the
 * per-track counter becomes `TrackArc` — the same `[data-track-progress]` block
 * with a ring around the same sentence, plus the earned Practiced/Mastered
 * counts that must always sit beside a self-reported number. The ring itself is
 * filled from the mastery states, not from the completion count: the design
 * calls it their macro rendering, and one filled pip anywhere in the track is a
 * third of a lesson's slice of it. ONE function in the island below still paints
 * every surface from one read, which is what keeps the cards and the rings from
 * disagreeing. A collapsed legend under the page head says what the three stages
 * are and who is grading them (the reader) — static copy, no key, no island.
 *
 * M8.2 adds the ready-to-review strip directly under the page head (spec §8) —
 * at most two quiet link-cards, and ZERO DOM when nothing is due, so a reader
 * with nothing to review never meets an empty state or an "all caught up"
 * badge. It is the only surface in the product that ever prompts, which is why
 * it is capped, wordless about lateness, and derived at render rather than
 * stored. `ReviewStrip` reads the SAME build-injected `data-lessons` list the
 * progress island does — one list, one schedule — and inserts itself after the
 * element carrying it, so its placement is not a second fact to keep in sync.
 *
 * M8.3 adds no surface here, only truth to an existing one. `ld:challenges:v1`
 * and `ld:finalrun:v1` are spec §6 PROGRESS keys, so the reset control clears
 * them — through `src/lib/progress.ts`, which owns the delete list — and its
 * confirm warning and its announcement now name whichever record kinds this
 * device actually holds. A reader whose only stored data is a cleared trial is
 * therefore neither told there is nothing to clear nor told that "0 completed
 * marks" went.
 *
 * JS off (or storage blocked): the CTA still points at lesson 01, the counters
 * stay hidden rather than lying "0 of 9" — with the store blocked the arcs mark
 * themselves unreadable instead of stating a zero nobody could verify — the
 * reset control, the legend and every M8 surface are hidden by their own
 * <noscript> kill-switches (none of them can work; the review strip has no
 * markup to hide in the first place), and every card stays a fully usable link
 * (§6 local completed state, §12 a11y).
 *
 * Landmarks/headings: BaseLayout owns <header>/<main>/<footer>; this page has one
 * <h1>, then an <h2> per track section (empty tracks show a "coming soon" note so
 * both labelled sections always render — spec §8 requires both), plus the review
 * strip's own <h2> on the visits where it has something to offer — the same
 * level, since it is a section of this page and not part of a track.
 */
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Collapsible from '../../components/Collapsible.astro';
import LessonCard from '../../components/LessonCard.astro';
import ReviewStrip from '../../components/ReviewStrip.astro';
import TrackArc from '../../components/TrackArc.astro';
import { TRACK_COPY, TRACK_ORDER } from '../../lib/tracks';
import {
  MASTERY_GATE_DAYS,
  resumeLabel,
  type LessonRef,
} from '../../lib/progress';

const published = await getCollection('lessons', ({ data }) => data.published);
const byOrder = (
  a: CollectionEntry<'lessons'>,
  b: CollectionEntry<'lessons'>,
) => a.data.order - b.data.order;

/**
 * The curriculum tracks in site-map order (§8), each with its lessons. Order,
 * headings and blurbs all come from `src/lib/tracks.ts`, so this page states no
 * track copy of its own — a rename lands in one place.
 */
const sections = TRACK_ORDER.map((id) => ({
  id,
  ...TRACK_COPY[id],
  lessons: published.filter((l) => l.data.track === id).sort(byOrder),
}));

/**
 * The lesson list the progress island reads (M7.2), in global order. Injected
 * from the build — never recovered by scanning localStorage keys, which would
 * count lessons that no longer exist (renamed or unpublished) and inflate every
 * counter on the page.
 */
const lessonRefs: LessonRef[] = published
  .map(({ data }) => ({
    slug: data.slug,
    title: data.title,
    order: data.order,
    track: data.track,
  }))
  .sort((a, b) => a.order - b.order);

/** First lesson in global order — the JS-off / nothing-stored resume target. */
const firstLesson = lessonRefs[0];

/**
 * Build guard for the review strip's deep link (M8.2).
 *
 * Every review card points at `/learn/{slug}?review=1#practice`, and that
 * fragment is the id Astro derives from the lesson's `## Practice` heading. A
 * heading renamed to anything else — "## Practice questions", or spec §7's own
 * long form "Practice / check yourself" — keeps the page valid and silently
 * turns the link into a no-op that dumps the reader at the top of the lesson.
 * That is invisible in review and invisible in the rendered page, so it fails
 * the build instead. Checked here rather than in the component because the
 * component builds its links at runtime from slugs alone, and this page is what
 * mounts it. Entries whose raw body cannot be read are skipped: a guard can only
 * assert about text it actually has.
 */
const missingPractice = published
  .filter(
    (entry) => entry.body && !/^##[ \t]+Practice[ \t]*$/m.test(entry.body),
  )
  .map((entry) => entry.data.slug);
if (missingPractice.length > 0) {
  throw new Error(
    `Lesson(s) ${missingPractice.join(', ')} have no "## Practice" heading, so the review strip's #practice deep link would land nowhere. Restore the heading (spec §7 body-section 7) or change ReviewStrip's target.`,
  );
}

/**
 * The CTA's server-rendered wording, from the SAME helper the island calls at
 * runtime (with "nothing complete yet" as the only honest build-time
 * assumption), so the fallback and the rewrite can never word a state twice.
 */
const resumeFallback = firstLesson
  ? resumeLabel(firstLesson, 0, lessonRefs.length)
  : '';
---

<BaseLayout
  title="Learn · LearnDSA"
  canonicalPath="/learn"
  description="The full LearnDSA curriculum: interactive data-structure and algorithm lessons, grouped into two tracks. Work through them in order or jump to any topic."
>
  <div class="learn">
    <header class="learn__head" data-lessons={JSON.stringify(lessonRefs)}>
      <h1>Curriculum</h1>
      <p class="learn__intro">
        {published.length} core lessons across two tracks. Work through them in order,
        or jump to any topic — each one is built around a visualization you can play,
        pause, and run on your own input. Lessons you finish are checked off on this
        device.
      </p>

      {
        firstLesson && (
          <div class="learn__resume">
            <a
              class="btn-primary learn__resume-link"
              href={`/learn/${firstLesson.slug}`}
              data-resume-link
            >
              <span data-resume-label>{resumeFallback}</span>
              <span aria-hidden="true">→</span>
            </a>
            {/* The all-complete state has no honest "next" destination, so the
                CTA steps aside for this line instead of linking somewhere
                arbitrary. Revealed by the island only. */}
            <p class="learn__resume-done" data-resume-done hidden />
          </div>
        )
      }

      {
        /* Reset control: JS-only (it cannot delete anything without script), so
           it ships visible for script-enabled readers — no layout shift on
           hydrate — and is removed entirely by the <noscript> kill-switch below,
           the same pattern MarkComplete and ThemeToggle use. It starts
           aria-disabled because the count is unknowable at build time. */
        firstLesson && (
          <div class="learn__reset">
            <button
              type="button"
              class="learn__reset-toggle"
              data-reset-toggle
              aria-expanded="false"
              aria-controls="reset-progress-panel"
              aria-disabled="true"
            >
              Reset progress
            </button>

            <div
              class="learn__reset-panel"
              id="reset-progress-panel"
              data-reset-panel
              hidden
            >
              <p
                class="learn__reset-warn"
                id="reset-progress-warn"
                data-reset-warn
              >
                {/* Rewritten by the island every time the panel opens, naming
                    only the record kinds this device actually holds. This is
                    the build's honest version of that sentence: it cannot know
                    the device, so it names every progress key §6 lists. */}
                Removes every completed mark, practice record and trial record
                stored on this device — cannot be undone.
              </p>
              <div class="learn__reset-actions">
                <button
                  type="button"
                  class="btn-secondary"
                  data-reset-confirm
                  aria-describedby="reset-progress-warn"
                >
                  Confirm
                </button>
                <button type="button" class="btn-secondary" data-reset-cancel>
                  Cancel
                </button>
              </div>
            </div>
          </div>
        )
      }

      <noscript>
        <style>
          /* No script, no delete path — hide the control rather than expose a
             dead one (same kill-switch as MarkComplete/ThemeToggle).
             !important so it can never lose to the bundled stylesheet. */
          .learn__reset {
            display: none !important;
          }

          /* The pip legend goes too. It needs no script — a native <details>
             opens on its own — but with JS off there is no pip, no ring and no
             stage word anywhere on this page, so it would be a legend for a
             thing that is not there. Same M8 rule the components apply: no
             gamification surface appears without JS. */
          .learn__legend {
            display: none !important;
          }

          /* The per-track counter's own kill-switch lives in TrackArc.astro
             (every M8 component ships one), so it is deliberately not restated
             here — one rule, in the component that owns the markup. */
        </style>
      </noscript>

      {
        /* Outcome of a reset, announced politely. role="status" carries an
          implicit aria-live="polite"; it is empty until the reader acts, so it
          never announces on load. */
      }
      <p class="learn__status" role="status" data-progress-status></p>

      {
        /* SPEC-GAP: neither spec §8 nor `docs/m8-gamification.md` names a legend
          for the currency — but both make the pips, the three stage words and
          "Practiced n · Mastered n" the product's entire progress language, and
          M8.1 shipped all of it with nothing anywhere saying what a pip means,
          how one is earned, or that the reader is the one doing the grading.
          This is the smallest thing that closes that: static copy in the site's
          existing disclosure idiom (`Collapsible` — a native `<details>`, so it
          needs no script of its own), collapsed by default, adding no key and no
          island. It sits directly above the first track's ring, which is the
          first place the words appear.
          Gated on `firstLesson` alongside the reset control so "Reset progress
          above" can never name a control this page did not render. */
        firstLesson && (
          <div class="learn__legend">
            <Collapsible summary="What the three pips mean">
              <p>
                Each lesson can fill up to three pips. They are your own notes
                to yourself: you decide when one is earned, nothing here is
                graded or checked, and nothing is ever taken away.
              </p>
              <dl class="learn__legend-list">
                <dt>Learned</dt>
                <dd>
                  You pressed "Mark as complete" at the end of the lesson.
                </dd>
                <dt>Practiced</dt>
                <dd>
                  You answered every practice question in the lesson and marked
                  each one "I had it".
                </dd>
                <dt>Mastered</dt>
                <dd>
                  You did that again, at least {MASTERY_GATE_DAYS} days after
                  the first time — that's how memory consolidates.
                </dd>
              </dl>
              <p>
                All three are kept on this device only, so clearing your browser
                data clears them — and "Reset progress" above removes them
                whenever you want.
              </p>
            </Collapsible>
          </div>
        )
      }
    </header>

    {
      /* The ready-to-review strip (M8.2). Nothing of the strip renders here —
         the component emits only its styles and its <noscript> kill-switch, and
         its island inserts the cards after the page head (the element above,
         which carries the injected lesson list) only when something is actually
         due. Mounted at the position it will occupy so the source reads in
         document order. */
    }
    <ReviewStrip />

    {
      sections.map((section) => (
        <section class="learn__section" aria-labelledby={`track-${section.id}`}>
          <div class="learn__section-head">
            <div class="learn__section-titles">
              <h2 id={`track-${section.id}`}>{section.heading}</h2>
              <p class="learn__section-blurb">{section.blurb}</p>
            </div>

            {/* Empty until the island fills it: "0 of 9" rendered server-side
                would be a claim about a device the build cannot see. Its SPACE
                is reserved all the same, and every rule about what this block
                says, reserves and hides lives in the component. An empty track
                gets none: there is no progress to report on zero lessons. */}
            {section.lessons.length > 0 && <TrackArc track={section.id} />}
          </div>

          {section.lessons.length > 0 ? (
            <ul class="learn__grid" role="list">
              {section.lessons.map((lesson) => (
                <li>
                  <LessonCard
                    slug={lesson.data.slug}
                    order={lesson.data.order}
                    title={lesson.data.title}
                    summary={lesson.data.summary}
                    difficulty={lesson.data.difficulty}
                    estimatedMinutes={lesson.data.estimatedMinutes}
                  />
                </li>
              ))}
            </ul>
          ) : (
            <p class="learn__empty">Lessons for this track are coming soon.</p>
          )}
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .learn {
    padding-block: var(--space-12) var(--space-16);
  }

  .learn__intro {
    margin-top: var(--space-4);
    max-width: var(--measure);
    color: var(--text-muted);
    font-size: var(--text-lg);
  }

  .learn__resume {
    margin-top: var(--space-6);
  }

  .learn__resume-link {
    gap: var(--space-2);
  }

  .learn__resume-done {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
  }

  /* Quiet by design: a destructive control should be findable, not competing
     with the resume CTA directly above it. */
  .learn__reset {
    margin-top: var(--space-4);
  }

  .learn__reset-toggle {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .learn__reset-toggle:hover {
    color: var(--text);
  }

  /* aria-disabled, not `disabled`: the button is where focus stands the instant
     the last mark is cleared, and a real `disabled` would drop that focus onto
     <body>. Same shared recipe every other disabled control uses (M7.1 CMP-3). */
  .learn__reset-toggle[aria-disabled='true'] {
    opacity: var(--disabled-opacity);
    cursor: not-allowed;
    text-decoration: none;
  }

  .learn__reset-toggle[aria-disabled='true']:hover {
    color: var(--text-muted);
  }

  .learn__reset-panel {
    max-width: var(--measure);
    margin-top: var(--space-2);
    padding: var(--space-4);
    border: 1px solid var(--accent-warn);
    border-radius: var(--radius-card);
    background-color: var(--surface);
  }

  .learn__reset-warn {
    color: var(--text);
    font-size: var(--text-sm);
  }

  .learn__reset-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  .learn__status {
    margin-top: var(--space-3);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  /* The pip legend. Quiet: it is reference material, not a call to action, so it
     takes the measure and the small type and stays closed until asked for. */
  .learn__legend {
    max-width: var(--measure);
    margin-top: var(--space-4);
  }

  .learn__legend p {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .learn__legend-list {
    margin-block: var(--space-3);
    font-size: var(--text-sm);
  }

  /* The stage word carries the weight; its sentence is muted body text, so the
     three read as a list of definitions rather than three headings. */
  .learn__legend-list dt {
    color: var(--text);
    font-weight: var(--weight-semibold);
  }

  .learn__legend-list dd {
    margin-inline-start: 0;
    margin-block-end: var(--space-3);
    color: var(--text-muted);
  }

  .learn__legend-list dd:last-child {
    margin-block-end: 0;
  }

  /* Only the margin collapses while the region is empty — never `display: none`.
     A live region that is un-hidden in the same frame as its text lands is the
     classic way to lose an announcement, so this one is always rendered; an
     empty <p> simply has no height. */
  .learn__status:empty {
    margin-top: 0;
  }

  .learn__section {
    margin-top: var(--space-12);
  }

  .learn__section-head {
    margin-bottom: var(--space-6);
  }

  /* From 640px the counter sits beside the heading block rather than under it;
     below that it stacks, which is why it reserves its own height. TrackArc
     carries the `flex: none` half of that arrangement — it is the item, and a
     scoped rule here could not reach it. */
  @media (min-width: 640px) {
    .learn__section-head {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: var(--space-6);
    }
  }

  /* The track heading is an anchor target — the lesson breadcrumb (M7.1 IA-6)
     and the home track cards both jump to `#track-{id}` — so it must clear the
     sticky header or the heading and its blurb land underneath it. --header-h
     (M7.2) is now the single source for that height, replacing the hardcoded
     4.5rem/5.5rem pair this rule used to carry: the gap below the header is a
     flat --space-4 at every breakpoint instead of 16px/24px. */
  .learn__section-titles h2 {
    scroll-margin-top: calc(var(--header-h) + var(--space-4));
  }

  .learn__section-blurb {
    margin-top: var(--space-1);
    color: var(--text-muted);
  }

  .learn__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .learn__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .learn__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .learn__empty {
    color: var(--text-muted);
    font-style: italic;
  }
</style>

<script>
  /**
   * Progress island for /learn (M7.2, extended by M8.1). Reflects the stored
   * progress keys onto four surfaces — the resume CTA, the per-track arcs, the
   * cards and the reset control — and owns the delete path.
   *
   * Every storage access goes through `src/lib/progress.ts`, so the try/catch
   * discipline and the "which keys count as progress" list live in one place
   * (M8 extended that module, not this file); every stage word and the ring
   * geometry come from `src/lib/mastery-ui.ts`, which the lesson header shares.
   * The several passes over storage this makes are deliberate: each is a
   * synchronous read of at most the 15 lessons' own keys, and calling the shared
   * helpers keeps every surface honest rather than re-deriving a stage locally
   * from a value that happens to be in hand.
   *
   * Re-runs on a back/forward-cache restore (`onRestore`) and on
   * `astro:page-load` so it survives View Transitions (M4); the reset controls
   * use delegated listeners for the same reason.
   */
  import {
    completeKey,
    countComplete,
    countMastery,
    hasStoredProgress,
    masteryStage,
    nextIncomplete,
    onRestore,
    parseLessonRefs,
    PROGRESS_RESET_EVENT,
    readCompleted,
    resetProgress,
    resumeLabel,
    storedProgress,
    type LessonRef,
  } from '../../lib/progress';
  import {
    arcOffset,
    masteryCountsText,
    paintPips,
    trackCountText,
  } from '../../lib/mastery-ui';

  /** Reads the build-injected lesson list; `[]` if the attribute is missing. */
  function lessons(): LessonRef[] {
    const host = document.querySelector<HTMLElement>('[data-lessons]');
    return parseLessonRefs(host?.dataset['lessons']);
  }

  /** "3 completed marks" / "1 completed mark" — used by the confirm and the announcement. */
  function marks(count: number): string {
    return `${count} completed mark${count === 1 ? '' : 's'}`;
  }

  /**
   * What a reset removes BESIDES completion marks, named in the reader's words:
   * "practice records", "trial records", or both.
   *
   * Two sentences share it — the confirm warning and the announcement — so a
   * device is described the same way before and after the delete. It names only
   * what is actually there, which is why it takes the storage reading rather
   * than a fixed phrase: "practice and trial records" on a device holding only
   * practice records would over-claim a delete the reader cannot undo.
   *
   * "Trial records" covers both enrichment keys (cleared Trace Trials and
   * cleared Final Runs) deliberately: the reader met them as one thing — puzzles
   * they cleared — and spelling out two internal key names in a warning sentence
   * would trade clarity for an accuracy nobody asked for.
   *
   * @param stored - The reading from `storedProgress`.
   * @returns The phrase without an article, or `''` when neither kind is stored
   * (each caller adds the article its own sentence needs).
   */
  function recordKinds(stored: {
    records: number;
    enrichment: boolean;
  }): string {
    const kinds: string[] = [];
    if (stored.records > 0) kinds.push('practice');
    if (stored.enrichment) kinds.push('trial');
    return kinds.length > 0 ? `${kinds.join(' and ')} records` : '';
  }

  /** Points the CTA at the first unfinished lesson, or stands it down when all are done. */
  function renderResume(list: LessonRef[], completed: number): void {
    const link =
      document.querySelector<HTMLAnchorElement>('[data-resume-link]');
    const label = document.querySelector<HTMLElement>('[data-resume-label]');
    const done = document.querySelector<HTMLElement>('[data-resume-done]');
    if (!link || !label || !done) return;

    const next = nextIncomplete(list);
    const text = resumeLabel(next, completed, list.length);
    if (next) {
      link.href = `/learn/${next.slug}`;
      label.textContent = text;
      done.hidden = true;
      link.hidden = false;
    } else {
      done.textContent = text;
      done.hidden = false;
      link.hidden = true;
    }
  }

  /**
   * How many pips one lesson can fill — the three of `MasteryPips`, which the
   * ring below sums across a track. Named rather than inlined because it is a
   * fact about that component, not an arbitrary divisor.
   */
  const PIPS_PER_LESSON = 3;

  /**
   * Can this device's storage actually be read?
   *
   * Every helper in `src/lib/progress.ts` degrades a blocked store to "nothing
   * recorded", which is the right answer for a checkmark and the WRONG one for a
   * counter: rendered, "0 of 9 done on this device" states as fact something
   * this page could not check, on a device that may well have nine marks in a
   * store the browser is refusing to open. So the surfaces that would otherwise
   * assert that zero ask this question first.
   *
   * The probe is a real read of a real spec §6 key (the first lesson's
   * completion mark) — nothing is written, nothing is enumerated, and the two
   * failure shapes both land in the catch: the global missing entirely (a
   * ReferenceError) and the getter throwing (Safari's blocked-methods mode).
   *
   * @param list - The build-injected lesson list; its first entry is the probe.
   * @returns True when a read completed without throwing.
   */
  function storageReadable(list: LessonRef[]): boolean {
    const probe = list[0];
    if (!probe) return false;
    try {
      localStorage.getItem(completeKey(probe.slug));
      return true;
    } catch {
      return false;
    }
  }

  /**
   * Fills each track's arc — count line, mastery counts, ring — and reveals it.
   *
   * @param list - The build-injected lesson list.
   * @param readable - Whether storage answered a read (see {@link storageReadable}).
   * With `false` the block states nothing at all and marks itself unreadable:
   * absent, not broken, and never a number nobody could verify.
   */
  function renderTracks(list: LessonRef[], readable: boolean): void {
    document
      .querySelectorAll<HTMLElement>('[data-track-progress]')
      .forEach((block) => {
        const track = block.dataset['trackProgress'];
        if (!track) return;
        const inTrack = list.filter((lesson) => lesson.track === track);
        if (inTrack.length === 0) return; // empty track keeps its "coming soon" note

        if (!readable) {
          // Both attributes move together: dropping `pending` is what proves the
          // island ran (a block still pending is indistinguishable from a script
          // that never executed), and `unreadable` is what hides it.
          block.removeAttribute('data-track-pending');
          block.setAttribute('data-track-unreadable', 'true');
          return;
        }
        block.removeAttribute('data-track-unreadable');

        const { done, total } = countComplete(inTrack);
        const text = block.querySelector<HTMLElement>('[data-track-count]');
        if (text) text.textContent = trackCountText(done, total);

        // The self-reported completion count is never displayed alone: "Mark as
        // complete" has no learning precondition, so the two EARNED counts are
        // rendered beside it always (`docs/m8-gamification.md`). They are
        // cumulative, so a lesson promoted to Mastered never makes the
        // Practiced number fall — a demotion this system does not have.
        const counts = countMastery(inTrack);
        const mastery = block.querySelector<HTMLElement>(
          '[data-track-mastery]',
        );
        if (mastery) {
          mastery.textContent = masteryCountsText(
            counts.practiced,
            counts.mastered,
          );
        }

        // The ring is the macro rendering of the MASTERY STATES, which is what
        // the design calls it — not of the completion marks. Driven by `done` it
        // sat at zero for a reader who had genuinely practised, displaying the
        // one number in this system that is nobody's evidence of anything. The
        // counts are cumulative, so summing them is the count of filled pips
        // across the track (Mastered fills 3, Practiced 2, Learned 1) and the
        // ring fills exactly as the cards below do. Only the offset is written —
        // the dash array was baked at build time.
        const ring = block.querySelector<SVGCircleElement>('[data-track-ring]');
        const pips = counts.learned + counts.practiced + counts.mastered;
        ring?.setAttribute(
          'stroke-dashoffset',
          String(arcOffset(pips, total * PIPS_PER_LESSON)),
        );

        // Drops `visibility: hidden`, not a `hidden` attribute: the block has
        // been holding its own height since SSR so this reveal shifts nothing.
        block.removeAttribute('data-track-pending');
      });
  }

  /**
   * Marks each card with its completion state and paints its mastery pips
   * (§6 local completed state; M8.1's "the done-checkmark becomes pip 1").
   *
   * `data-complete` stays on the card and keeps its exact M7 meaning — the
   * completion MARK, which is also the only thing the reset control counts —
   * while `data-stage` carries the wider currency the pips draw. Both are
   * written in this one synchronous pass over the same store (the stage costs a
   * second read of the same key, deliberately: `masteryStage` is where the
   * OR-win rule lives, and re-deriving it here would be a second definition),
   * so the mark and the pips on a card can never contradict each other.
   */
  function renderCards(completed: string[]): void {
    const done = new Set(completed);
    document
      .querySelectorAll<HTMLElement>('[data-lesson-card]')
      .forEach((card) => {
        const slug = card.dataset['slug'];
        if (!slug) return;
        if (done.has(slug)) card.setAttribute('data-complete', 'true');
        else card.removeAttribute('data-complete');

        const pips = card.querySelector<HTMLElement>('[data-mastery-pips]');
        if (pips) paintPips(pips, masteryStage(slug));
      });
  }

  /**
   * Nothing stored = nothing to delete, so the control reads as unavailable.
   *
   * The question is `hasStoredProgress`, not the completion count, since M8.1:
   * a reader who self-graded practice without ever clicking "Mark as complete"
   * has a `progress:v1:{slug}` record on the device, and a control gated on
   * marks alone would present itself as "nothing to clear" while holding it.
   * M8.3 widened the same question rather than adding a second one — a device
   * whose only stored data is a cleared Trace Trial reaches this control too.
   */
  function renderReset(list: LessonRef[]): void {
    const toggle = document.querySelector<HTMLElement>('[data-reset-toggle]');
    toggle?.setAttribute(
      'aria-disabled',
      hasStoredProgress(list) ? 'false' : 'true',
    );
  }

  /** Redraws every progress surface from storage. */
  function render(): void {
    const list = lessons();
    if (list.length === 0) return; // no injected list: leave every fallback alone
    const completed = readCompleted(list);
    renderResume(list, completed.length);
    // Asked once per render, not once per surface: the answer cannot change
    // mid-pass, and two probes would be two reads for one question.
    renderTracks(list, storageReadable(list));
    renderCards(completed);
    renderReset(list);
  }

  /** Writes the polite announcement region (empty until the reader acts). */
  function announce(message: string): void {
    const status = document.querySelector<HTMLElement>(
      '[data-progress-status]',
    );
    if (status) status.textContent = message;
  }

  /**
   * Opens the inline confirm step — deliberately not `window.confirm`, which is
   * unstyleable, unannounced in place, and blocks the page. Focus stays on the
   * toggle (a disclosure, not a dialog): moving it onto "Confirm" would put a
   * destructive button under a Space keypress the reader has not released yet.
   */
  function openPanel(toggle: HTMLElement, panel: HTMLElement): void {
    const stored = storedProgress(lessons());
    const kinds = recordKinds(stored);
    const warn = panel.querySelector<HTMLElement>('[data-reset-warn]');
    if (warn) {
      // A device with records but no marks — practice-only, or one that has
      // only cleared trials — must not be told "0 completed marks", which would
      // describe the delete as a no-op it is not. The three §6 progress shapes
      // are named in whatever combination is actually stored; the fallback
      // never renders (the toggle is aria-disabled with nothing stored) and is
      // here so no arrangement of this sentence can come out empty.
      const what =
        stored.marks > 0
          ? kinds
            ? `${marks(stored.marks)} and the ${kinds}`
            : marks(stored.marks)
          : kinds
            ? `the ${kinds}`
            : 'the progress';
      warn.textContent = `Removes ${what} stored on this device — cannot be undone.`;
    }
    panel.hidden = false;
    toggle.setAttribute('aria-expanded', 'true');
  }

  /** Collapses the confirm step and returns focus to the toggle it came from. */
  function closePanel(): void {
    const toggle = document.querySelector<HTMLElement>('[data-reset-toggle]');
    const panel = document.querySelector<HTMLElement>('[data-reset-panel]');
    if (!toggle || !panel || panel.hidden) return;
    panel.hidden = true;
    toggle.setAttribute('aria-expanded', 'false');
    // aria-disabled (not `disabled`) keeps this a valid focus target even when
    // the reset just emptied it, so focus never lands on <body>.
    toggle.focus();
  }

  /** Confirm: clear the keys, redraw every surface in place, say what happened. */
  function confirmReset(): void {
    const list = lessons();
    // Read BEFORE the delete, and only then: `resetProgress` counts the
    // completion marks it removed and deliberately counts neither mastery
    // records nor the enrichment keys (neither a practice record nor a cleared
    // trial is a "mark"), so this is the only moment the rest is still there to
    // be named.
    const stored = storedProgress(list);
    const kinds = recordKinds(stored);
    const removed = resetProgress(list);
    closePanel();
    render();
    // The review strip paints from the records this just deleted, and it is a
    // SECOND island with no shared scope — so it is told, or it keeps inviting
    // the reader to review lessons the device no longer remembers. Announced
    // rather than called: this file must not learn how another component
    // renders itself.
    document.dispatchEvent(new CustomEvent(PROGRESS_RESET_EVENT));
    // Said in the same units the warning used, so the reader hears back exactly
    // what they agreed to: the marks the delete actually removed (never the
    // count it hoped to — a blocked key is not a removal), plus whichever other
    // record kinds were there. "Nothing to reset" is what a clean device and a
    // blocked store both come out as, which is the honest answer for both.
    announce(
      removed > 0
        ? `Progress reset — ${marks(removed)} removed from this device${
            kinds ? `, along with the ${kinds}` : ''
          }.`
        : kinds
          ? `Progress reset — ${kinds} removed from this device.`
          : 'Nothing to reset — no progress was stored on this device.',
    );
  }

  document.addEventListener('click', (event) => {
    const target = event.target instanceof Element ? event.target : null;
    if (!target) return;

    const toggle = target.closest<HTMLElement>('[data-reset-toggle]');
    if (toggle) {
      if (toggle.getAttribute('aria-disabled') === 'true') return;
      const panel = document.querySelector<HTMLElement>('[data-reset-panel]');
      if (!panel) return;
      if (panel.hidden) openPanel(toggle, panel);
      else closePanel();
      return;
    }
    if (target.closest('[data-reset-confirm]')) {
      confirmReset();
      return;
    }
    if (target.closest('[data-reset-cancel]')) closePanel();
  });

  // Escape closes the confirm step from the control it belongs to — the panel OR
  // the toggle that owns it — and from nowhere else, so it can never swallow an
  // Escape meant for something else on the page. The toggle has to be in that
  // set: `openPanel` deliberately leaves focus there (a disclosure, not a
  // dialog), and it is the panel's SIBLING, so a `panel.contains()` test alone
  // made Escape a no-op at the exact moment a destructive confirm opened.
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const panel = document.querySelector<HTMLElement>('[data-reset-panel]');
    if (!panel || panel.hidden) return;
    const target = event.target instanceof Node ? event.target : null;
    if (!target) return;
    const toggle = document.querySelector<HTMLElement>('[data-reset-toggle]');
    if (panel.contains(target) || toggle?.contains(target)) closePanel();
  });

  render();
  // A back/forward-cache restore replays no script, so the counts, the CTA and
  // the checkmarks would all show whatever they said when the reader left for a
  // lesson — including the one they just marked done. (`astro:page-load` covers
  // View Transitions if a ClientRouter is ever added; none is installed today,
  // so it is the pageshow hook that actually fires.)
  onRestore(render);
  document.addEventListener('astro:page-load', render);
</script>
