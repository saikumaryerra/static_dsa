---
/**
 * Curriculum index — `/learn` (site spec §6 site map, §8 layout).
 *
 * Data-driven: queries the published lessons, groups them into the two tracks
 * (Foundations / Algorithms), and sorts each by `order`, so new lessons appear
 * automatically as later M4 batches add `.mdx` files — this page never lists a
 * lesson by hand. Each lesson renders as a `LessonCard`; a tiny reflect script
 * reads the SAME `lesson:{slug}:complete` key `MarkComplete` writes and shows a
 * done-checkmark. With JS off the script never runs, so no checkmark shows and
 * every card stays a fully usable link (§6 local completed state, §12 a11y).
 *
 * Landmarks/headings: BaseLayout owns <header>/<main>/<footer>; this page has one
 * <h1>, then an <h2> per track section (empty tracks show a "coming soon" note so
 * both labelled sections always render — spec §8 requires both).
 */
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LessonCard from '../../components/LessonCard.astro';
import { TRACK_COPY, TRACK_ORDER } from '../../lib/tracks';

const published = await getCollection('lessons', ({ data }) => data.published);
const byOrder = (
  a: CollectionEntry<'lessons'>,
  b: CollectionEntry<'lessons'>,
) => a.data.order - b.data.order;

/**
 * The curriculum tracks in site-map order (§8), each with its lessons. Order,
 * headings and blurbs all come from `src/lib/tracks.ts`, so this page states no
 * track copy of its own — a rename lands in one place.
 */
const sections = TRACK_ORDER.map((id) => ({
  id,
  ...TRACK_COPY[id],
  lessons: published.filter((l) => l.data.track === id).sort(byOrder),
}));
---

<BaseLayout
  title="Learn · LearnDSA"
  canonicalPath="/learn"
  description="The full LearnDSA curriculum: interactive data-structure and algorithm lessons, grouped into two tracks. Work through them in order or jump to any topic."
>
  <div class="learn">
    <header class="learn__head">
      <h1>Curriculum</h1>
      <p class="learn__intro">
        {published.length} core lessons across two tracks. Work through them in order,
        or jump to any topic — each one is built around a visualization you can play,
        pause, and run on your own input. Lessons you finish are checked off on this
        device.
      </p>
    </header>

    {
      sections.map((section) => (
        <section class="learn__section" aria-labelledby={`track-${section.id}`}>
          <div class="learn__section-head">
            <h2 id={`track-${section.id}`}>{section.heading}</h2>
            <p class="learn__section-blurb">{section.blurb}</p>
          </div>

          {section.lessons.length > 0 ? (
            <ul class="learn__grid" role="list">
              {section.lessons.map((lesson) => (
                <li>
                  <LessonCard
                    slug={lesson.data.slug}
                    order={lesson.data.order}
                    title={lesson.data.title}
                    summary={lesson.data.summary}
                    difficulty={lesson.data.difficulty}
                    estimatedMinutes={lesson.data.estimatedMinutes}
                  />
                </li>
              ))}
            </ul>
          ) : (
            <p class="learn__empty">Lessons for this track are coming soon.</p>
          )}
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .learn {
    padding-block: var(--space-12) var(--space-16);
  }

  .learn__intro {
    margin-top: var(--space-4);
    max-width: var(--measure);
    color: var(--text-muted);
    font-size: var(--text-lg);
  }

  .learn__section {
    margin-top: var(--space-12);
  }

  .learn__section-head {
    margin-bottom: var(--space-6);
  }

  /* The track heading is an anchor target — the lesson breadcrumb (M7.1 IA-6) and
     the home track cards both jump to `#track-{id}` — so it must clear the sticky
     header (56px, 64px ≥768px) or the heading and its blurb land underneath it.
     Same offsets LessonLayout and /glossary use; M7.2's `--header-h` token
     replaces all four hardcoded copies. */
  .learn__section-head h2 {
    scroll-margin-top: 4.5rem;
  }

  @media (min-width: 768px) {
    .learn__section-head h2 {
      scroll-margin-top: 5.5rem;
    }
  }

  .learn__section-blurb {
    margin-top: var(--space-1);
    color: var(--text-muted);
  }

  .learn__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .learn__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .learn__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .learn__empty {
    color: var(--text-muted);
    font-style: italic;
  }
</style>

<script>
  /**
   * Reflect completion from localStorage onto each card. Reads the exact key
   * `MarkComplete` writes (`lesson:{slug}:complete = "1"`). Wrapped in try/catch
   * so blocked/again-private storage simply yields no checkmarks (cards stay
   * usable). Re-runs on `astro:page-load` so it survives View Transitions (M4).
   */
  function reflectCompletion(): void {
    let store: Storage | null = null;
    try {
      store = window.localStorage;
    } catch {
      return; // storage blocked: no checkmarks, cards still fully usable
    }
    document
      .querySelectorAll<HTMLElement>('[data-lesson-card]')
      .forEach((card) => {
        const slug = card.dataset['slug'];
        if (!slug) return;
        // getItem itself can throw in blocked-methods mode (Safari private):
        // guard it (mirrors MarkComplete.readDone) so a throw yields no
        // checkmark and never becomes an uncaught pageerror.
        let done: boolean;
        try {
          done = store?.getItem(`lesson:${slug}:complete`) === '1';
        } catch {
          return; // storage read blocked: leave this card unmarked, keep going
        }
        if (done) card.setAttribute('data-complete', 'true');
        else card.removeAttribute('data-complete');
      });
  }

  reflectCompletion();
  document.addEventListener('astro:page-load', reflectCompletion);
</script>
