---
/**
 * Lesson page — renders one published lesson from the collection (architecture §1.2).
 *
 * `getStaticPaths` builds a page per PUBLISHED lesson, routing off frontmatter
 * `data.slug` (Content Layer entry `id` is the filename, not the slug). Two
 * build-time guards live here because Zod validates one entry at a time and can
 * never see the collection: duplicate slugs, (M7.2) `prerequisites` that name an
 * unknown or unpublished lesson, and (course expansion, decision D-05) a lesson
 * slug that would collide with a course page's URL. Prev/next derive from
 * `order` **within the lesson's own course**. Reading time is computed from the
 * raw MDX body prose.
 */
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import LessonLayout from '../../layouts/LessonLayout.astro';
import { readingTimeMinutes } from '../../lib/reading-time';
import { trackLabel } from '../../lib/tracks';
import { COURSE_ORDER } from '../../lib/courses';
import type { LessonRef } from '../../lib/progress';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons', ({ data }) => data.published);

  // SPEC-GAP (architecture §1.1): enforce slug uniqueness here — Zod validates
  // per-entry and cannot see collisions across files.
  const seen = new Set<string>();
  for (const lesson of lessons) {
    if (seen.has(lesson.data.slug)) {
      throw new Error(
        `Duplicate lesson slug "${lesson.data.slug}" — slugs must be unique (see ${lesson.id}).`,
      );
    }
    seen.add(lesson.data.slug);
  }

  // M7.2: referential integrity for `prerequisites`, mirroring the glossary's
  // dead-link guard (`glossary.astro`). The schema only checks the SHAPE of the
  // array, so before M7.2 rendered it a typo'd or unpublished slug shipped
  // silently; now it FAILS THE BUILD. This loop covers every published lesson,
  // not just the one being rendered, so it cannot be dodged.
  for (const lesson of lessons) {
    for (const prerequisite of lesson.data.prerequisites) {
      if (!seen.has(prerequisite)) {
        throw new Error(
          `Lesson "${lesson.data.slug}" lists unknown/unpublished prerequisite "${prerequisite}" (see ${lesson.id}).`,
        );
      }
    }
  }

  // Course expansion (decision D-05): course pages are served at
  // `/learn/{course}/`, in the same path namespace this route owns. Astro would
  // resolve the static page and the dynamic one to the same output file, so a
  // lesson may never take a course's slug. Cheap guard, silent bug prevented.
  for (const reserved of COURSE_ORDER) {
    if (seen.has(reserved)) {
      throw new Error(
        `Lesson slug "${reserved}" collides with the course page served at /learn/${reserved}/ — rename the lesson.`,
      );
    }
  }

  return lessons.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry, lessons },
  }));
}

interface Props {
  entry: CollectionEntry<'lessons'>;
  lessons: CollectionEntry<'lessons'>[];
}

const { entry, lessons } = Astro.props;
const { Content, headings } = await render(entry);

// Prev/next: neighbours by `order` across every track OF THIS COURSE (M7.1
// IA-5). Spec §8: "Prev/next follow global lesson order, naming the track when
// it changes — never dead-ending at a track boundary (§3 'no dead ends')". A
// course page numbers its lessons 01–NN as one linear path, so the old
// per-track filter left the last Foundations lesson with no Next card at all.
//
// Course expansion (decision D-04): the chain stops at the COURSE boundary, not
// the track boundary. Finishing Dynamic Programming does not lead into
// Kubernetes — that is a different subject, not the next step — and `order` is
// per-course, so a global sort would interleave three unrelated sequences.
// Copy before sorting: `lessons` is shared by every page's props.
const inCourse = lessons.filter((l) => l.data.course === entry.data.course);
const ordered = [...inCourse].sort((a, b) => a.data.order - b.data.order);
const position = ordered.findIndex((l) => l.data.slug === entry.data.slug);
const toAdjacent = (l: CollectionEntry<'lessons'> | undefined) =>
  l
    ? {
        slug: l.data.slug,
        title: l.data.title,
        // Only a neighbour in a DIFFERENT track carries a label, so a crossing
        // (in `dsa`: 09 Graphs -> 10 Recursion) announces itself while every
        // other pair stays visually unchanged. The label rides inside the
        // adjacent object, which LessonLayout already forwards to PrevNext
        // untouched.
        ...(l.data.track === entry.data.track
          ? {}
          : { trackLabel: trackLabel(l.data.track) }),
      }
    : null;
const prev = toAdjacent(ordered[position - 1]);
const next = toAdjacent(ordered[position + 1]);

// "Builds on:" chips (M7.2). Every slug here is guaranteed to resolve — the
// guard in getStaticPaths fails the build otherwise — so the lookup is safe.
// Sorted by curriculum order rather than the authoring order, so the row always
// reads earliest-first regardless of how the frontmatter array was typed.
// Looked up across the WHOLE catalogue, not just this course: a prerequisite is
// allowed to point at another course, and the getStaticPaths guard already
// proved every slug resolves.
const bySlug = new Map(lessons.map((l) => [l.data.slug, l]));
const courseRank = (l: CollectionEntry<'lessons'>) =>
  COURSE_ORDER.indexOf(l.data.course);
const prerequisites = entry.data.prerequisites
  .map((s) => bySlug.get(s)!)
  .sort((a, b) => courseRank(a) - courseRank(b) || a.data.order - b.data.order)
  .map((l) => ({ slug: l.data.slug, title: l.data.title }));

// The curriculum, injected into the page for the progress module (spec §6): the
// completion count is computed from THIS list, never by enumerating
// localStorage keys, so a renamed lesson's stale key can't inflate it.
//
// `track` is load-bearing here, not decoration: M8.1's Quiet Milestone filters
// this same list down to the lesson's own track inside `MarkComplete` (one
// build-time `filter`, which is why no `trackSlugs` prop is threaded through the
// layout). Dropping the field would silently retire the milestone.
const lessonRefs: LessonRef[] = lessons.map((l) => ({
  slug: l.data.slug,
  title: l.data.title,
  order: l.data.order,
  track: l.data.track,
  course: l.data.course,
}));

const readingMinutes = readingTimeMinutes(entry.body ?? '');
---

<LessonLayout
  entry={entry}
  title={entry.data.title}
  summary={entry.data.summary}
  difficulty={entry.data.difficulty}
  track={entry.data.track}
  course={entry.data.course}
  estimatedMinutes={entry.data.estimatedMinutes}
  readingMinutes={readingMinutes}
  slug={entry.data.slug}
  headings={headings}
  prerequisites={prerequisites}
  lessons={lessonRefs}
  prev={prev}
  next={next}
>
  <Content />
</LessonLayout>
