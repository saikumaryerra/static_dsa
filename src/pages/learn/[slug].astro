---
/**
 * Lesson page — renders one published lesson from the collection (architecture §1.2).
 *
 * `getStaticPaths` builds a page per PUBLISHED lesson, routing off frontmatter
 * `data.slug` (Content Layer entry `id` is the filename, not the slug). Two
 * build-time guards live here because Zod validates one entry at a time and can
 * never see the collection: duplicate slugs, and (M7.2) `prerequisites` that
 * name an unknown or unpublished lesson. Prev/next derive from `order` across
 * the whole curriculum. Reading time is computed from the raw MDX body prose.
 */
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import LessonLayout from '../../layouts/LessonLayout.astro';
import { readingTimeMinutes } from '../../lib/reading-time';
import { trackLabel } from '../../lib/tracks';
import type { LessonRef } from '../../lib/progress';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons', ({ data }) => data.published);

  // SPEC-GAP (architecture §1.1): enforce slug uniqueness here — Zod validates
  // per-entry and cannot see collisions across files.
  const seen = new Set<string>();
  for (const lesson of lessons) {
    if (seen.has(lesson.data.slug)) {
      throw new Error(
        `Duplicate lesson slug "${lesson.data.slug}" — slugs must be unique (see ${lesson.id}).`,
      );
    }
    seen.add(lesson.data.slug);
  }

  // M7.2: referential integrity for `prerequisites`, mirroring the glossary's
  // dead-link guard (`glossary.astro`). The schema only checks the SHAPE of the
  // array, so before M7.2 rendered it a typo'd or unpublished slug shipped
  // silently; now it FAILS THE BUILD. This loop covers every published lesson,
  // not just the one being rendered, so it cannot be dodged.
  for (const lesson of lessons) {
    for (const prerequisite of lesson.data.prerequisites) {
      if (!seen.has(prerequisite)) {
        throw new Error(
          `Lesson "${lesson.data.slug}" lists unknown/unpublished prerequisite "${prerequisite}" (see ${lesson.id}).`,
        );
      }
    }
  }

  return lessons.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry, lessons },
  }));
}

interface Props {
  entry: CollectionEntry<'lessons'>;
  lessons: CollectionEntry<'lessons'>[];
}

const { entry, lessons } = Astro.props;
const { Content, headings } = await render(entry);

// Prev/next: neighbours by `order` across BOTH tracks (M7.1 IA-5). Spec §8:
// "Prev/next follow global lesson order, naming the track when it changes —
// never dead-ending at a track boundary (§3 'no dead ends')". /learn numbers the
// curriculum 01–15 as one linear path, so the old per-track filter left lesson
// 09 with no Next card at all.
// Copy before sorting: `lessons` is shared by every page's props.
const ordered = [...lessons].sort((a, b) => a.data.order - b.data.order);
const position = ordered.findIndex((l) => l.data.slug === entry.data.slug);
const toAdjacent = (l: CollectionEntry<'lessons'> | undefined) =>
  l
    ? {
        slug: l.data.slug,
        title: l.data.title,
        // Only a neighbour in a DIFFERENT track carries a label, so the single
        // crossing (09 Graphs → 10 Recursion) announces itself while the other
        // 13 pairs stay visually unchanged. The label rides inside the adjacent
        // object, which LessonLayout already forwards to PrevNext untouched.
        ...(l.data.track === entry.data.track
          ? {}
          : { trackLabel: trackLabel(l.data.track) }),
      }
    : null;
const prev = toAdjacent(ordered[position - 1]);
const next = toAdjacent(ordered[position + 1]);

// "Builds on:" chips (M7.2). Every slug here is guaranteed to resolve — the
// guard in getStaticPaths fails the build otherwise — so the lookup is safe.
// Sorted by curriculum order rather than the authoring order, so the row always
// reads earliest-first regardless of how the frontmatter array was typed.
const bySlug = new Map(ordered.map((l) => [l.data.slug, l]));
const prerequisites = entry.data.prerequisites
  .map((s) => bySlug.get(s)!)
  .sort((a, b) => a.data.order - b.data.order)
  .map((l) => ({ slug: l.data.slug, title: l.data.title }));

// The curriculum, injected into the page for the progress module (spec §6): the
// completion count is computed from THIS list, never by enumerating
// localStorage keys, so a renamed lesson's stale key can't inflate it.
const lessonRefs: LessonRef[] = ordered.map((l) => ({
  slug: l.data.slug,
  title: l.data.title,
  order: l.data.order,
  track: l.data.track,
}));

const readingMinutes = readingTimeMinutes(entry.body ?? '');
---

<LessonLayout
  entry={entry}
  title={entry.data.title}
  summary={entry.data.summary}
  difficulty={entry.data.difficulty}
  track={entry.data.track}
  estimatedMinutes={entry.data.estimatedMinutes}
  readingMinutes={readingMinutes}
  slug={entry.data.slug}
  headings={headings}
  prerequisites={prerequisites}
  lessons={lessonRefs}
  prev={prev}
  next={next}
>
  <Content />
</LessonLayout>
