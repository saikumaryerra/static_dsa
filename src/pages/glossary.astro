---
/**
 * Glossary — `/glossary` (spec §6, §8; M5 architecture §1, design §1).
 *
 * Static, ZERO island JS: the jump bar is native in-page anchors and CSS-only
 * sticky/scroll-margin, so the page is fully usable with JavaScript disabled.
 *
 * Build-time validation (arch §1.3): every glossary `lessonSlug` is checked
 * against the PUBLISHED lessons collection; an unknown/unpublished slug throws and
 * FAILS THE BUILD, so a renamed or deleted lesson can never ship a dead cross-link.
 * Lesson titles for the "Introduced in …" links are resolved from the collection
 * (never hardcoded in glossary.ts). M7.2 adds the mirror guard for the other
 * direction: per-term `id`s must be unique and must not clash with a structural id,
 * because lesson prose now hard-links `/glossary#{term}` (spec §8).
 *
 * Landmarks/headings: BaseLayout owns <header>/<main>/<footer>; this page has one
 * <h1>, an <h2> per present letter, a labelled jump <nav>, and <dl>/<dt>/<dd>
 * definition-list semantics. Empty letters are dimmed AND aria-disabled AND
 * non-links (skipped in Tab order) — structural, never color-only.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { glossary, termAnchor } from '../lib/glossary';
import type { GlossaryTerm } from '../lib/glossary';

const published = await getCollection('lessons', ({ data }) => data.published);

// slug → title lookup, and a set for the validator.
const titleBySlug = new Map(published.map((l) => [l.data.slug, l.data.title]));

// Fail the build on any dead cross-link (arch §1.3) — mirrors the duplicate-slug
// guard in learn/[slug].astro. Self-correcting: bad slugs never reach production.
for (const term of glossary) {
  if (!titleBySlug.has(term.lessonSlug)) {
    throw new Error(
      `Glossary term "${term.term}" → unknown/unpublished lesson "${term.lessonSlug}".`,
    );
  }
}

/** A glossary entry enriched with the resolved lesson title (design §1.7). */
interface GlossaryEntry extends GlossaryTerm {
  lessonTitle: string;
}

// Sort A–Z case-insensitively by term (arch §1.3 step 2).
const sorted: GlossaryEntry[] = [...glossary]
  .map((t) => ({ ...t, lessonTitle: titleBySlug.get(t.lessonSlug)! }))
  .sort((a, b) => a.term.localeCompare(b.term, 'en', { sensitivity: 'base' }));

/**
 * First-letter bucket for a term. Non-alphabetic leads collapse to '#'.
 * SPEC-GAP (arch §1.3): §8 is silent on numerics/symbols; '#' is the simplest
 * correct single bucket. No terms currently fall here, but it is defensive.
 */
function bucketOf(term: string): string {
  const first = term.charAt(0).toUpperCase();
  return first >= 'A' && first <= 'Z' ? first : '#';
}

// Group into present buckets only (empty letters render NO section — design §1.2).
const groups = new Map<string, GlossaryEntry[]>();
for (const entry of sorted) {
  const letter = bucketOf(entry.term);
  const list = groups.get(letter) ?? [];
  list.push(entry);
  groups.set(letter, list);
}

// The 26 letters, each flagged present (has a section) or empty (dimmed chip).
const ALPHABET = Array.from({ length: 26 }, (_, i) =>
  String.fromCharCode(65 + i),
);
const presentLetters = new Set(groups.keys());

// Ordered list of present sections (A→Z; the '#' bucket, if ever used, leads).
const sections = ALPHABET.filter((l) => presentLetters.has(l))
  .concat(presentLetters.has('#') ? ['#'] : [])
  .map((letter) => ({ letter, entries: groups.get(letter)! }));

/** Stable, URL-safe fragment id for a letter section ('#' → 'num'). */
const sectionId = (letter: string) =>
  `letter-${letter === '#' ? 'num' : letter.toLowerCase()}`;

// Per-term anchors (M7.2): every entry is deep-linkable as /glossary#{anchor}, and
// lesson prose hard-links those ids. Two terms slugifying alike would silently make
// one unreachable and the other's link wrong, so — in the same self-correcting
// spirit as the dead-link guard above — a collision FAILS THE BUILD. Ids already
// spent on page structure are reserved: a duplicate id is invalid HTML and would
// break the letter jump bar too.
const reservedIds = new Set<string>([
  'top', // the page header sentinel
  'main', // BaseLayout's skip-to-content target
  ...ALPHABET.map(sectionId),
  sectionId('#'),
]);
const anchorOwner = new Map<string, string>();
for (const term of glossary) {
  const anchor = termAnchor(term.term);
  if (anchor === '') {
    throw new Error(
      `Glossary term "${term.term}" slugifies to an empty anchor id.`,
    );
  }
  if (reservedIds.has(anchor)) {
    throw new Error(
      `Glossary term "${term.term}" slugifies to "#${anchor}", which is reserved by the page structure.`,
    );
  }
  const owner = anchorOwner.get(anchor);
  if (owner !== undefined) {
    throw new Error(
      `Glossary anchor collision: "${owner}" and "${term.term}" both slugify to "#${anchor}".`,
    );
  }
  anchorOwner.set(anchor, term.term);
}
---

<BaseLayout
  title="Glossary · LearnDSA"
  description="A–Z reference of the data-structure and algorithm terms used across LearnDSA, each linked to the lesson that introduces it."
  canonicalPath="/glossary"
>
  <div class="glossary">
    <header id="top" class="glossary__head">
      <h1>Glossary</h1>
      <p class="glossary__intro">
        Every term the lessons introduce, defined in one or two sentences and
        linked back to where you first meet it.
      </p>
    </header>

    {
      sections.length === 0 ? (
        <p class="glossary__empty">
          The glossary is being written — check back soon.
        </p>
      ) : (
        <>
          {/* FILTER (redesign 2026-08). Spec §19 left this open as an owner
              decision — "Glossary search island (~1 KB)" — and forty-six terms
              down a 10,000px page is exactly the case it was left open for: the
              A–Z chips answer "take me to L", and nothing answered "where is
              the thing I half-remember the name of".

              It filters what is already on the page; it fetches nothing, indexes
              nothing and stores nothing. It ships `hidden` and the island
              reveals it, because a text field that cannot filter is worse than
              no field — the same rule every M8 control follows. With JavaScript
              off the complete A–Z list and its jump nav are untouched. */}
          <form
            class="glossary__search"
            data-glossary-search
            hidden
            role="search"
            onsubmit="return false"
          >
            <label class="glossary__search-label" for="glossary-filter">
              Filter terms
            </label>
            <div class="glossary__search-field">
              <svg
                class="glossary__search-icon"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="11" cy="11" r="7" />
                <path d="M20 20l-3.5-3.5" />
              </svg>
              <input
                id="glossary-filter"
                type="search"
                class="glossary__search-input"
                placeholder="hash, traversal, O(n)…"
                autocomplete="off"
                autocorrect="off"
                autocapitalize="off"
                spellcheck="false"
                data-glossary-input
              />
              <button
                type="button"
                class="glossary__search-clear"
                data-glossary-clear
                hidden
              >
                Clear
              </button>
            </div>
            {/* Polite, not assertive: the reader is typing, and an assertive
                region would interrupt them on every keystroke. Empty until a
                filter is actually applied, so it never announces the resting
                state of the page. */}
            <p
              class="glossary__search-status"
              role="status"
              data-glossary-status
            />
          </form>

          <nav
            class="glossary__jump"
            aria-label="Jump to letter"
            data-glossary-jump
          >
            <ul>
              {ALPHABET.map((letter) =>
                presentLetters.has(letter) ? (
                  <li>
                    <a class="glossary__chip" href={`#${sectionId(letter)}`}>
                      {letter}
                    </a>
                  </li>
                ) : (
                  <li>
                    <span
                      class="glossary__chip glossary__chip--empty"
                      aria-disabled="true"
                    >
                      {letter}
                    </span>
                  </li>
                ),
              )}
            </ul>
          </nav>

          <p class="glossary__no-match" data-glossary-nomatch hidden />

          <div class="glossary__sections">
            {sections.map(({ letter, entries }) => (
              <section
                id={sectionId(letter)}
                data-glossary-section
                aria-labelledby={`${sectionId(letter)}-h`}
              >
                <h2 id={`${sectionId(letter)}-h`} class="glossary__letter">
                  {letter}
                </h2>
                <dl class="glossary__list">
                  {entries.map((entry) => (
                    <div
                      class="glossary__entry"
                      id={termAnchor(entry.term)}
                      data-glossary-entry
                      data-haystack={[
                        entry.term,
                        ...(entry.aliases ?? []),
                        entry.definition,
                      ]
                        .join(' ')
                        .toLowerCase()}
                    >
                      <dt class="glossary__term">{entry.term}</dt>
                      <dd class="glossary__def">
                        <p>{entry.definition}</p>
                        {entry.aliases && entry.aliases.length > 0 && (
                          <p class="glossary__aliases">
                            Also called: {entry.aliases.join(', ')}
                          </p>
                        )}
                        <p class="glossary__xref-line">
                          <a
                            class="glossary__xref"
                            href={`/learn/${entry.lessonSlug}`}
                          >
                            Introduced in {entry.lessonTitle}{' '}
                            <span aria-hidden="true">→</span>
                          </a>
                        </p>
                      </dd>
                    </div>
                  ))}
                </dl>
              </section>
            ))}
          </div>
        </>
      )
    }
  </div>
</BaseLayout>

<style>
  .glossary {
    padding-block: var(--space-12) var(--space-16);
    /* The PAGE is no longer capped at --measure (redesign 2026-08). It was, and
       that cap is what squeezed the new two-column layout into 750px — half a
       shell — making each column narrower than a single column had been. The
       measure belongs to the things that are prose: the page head below, and
       each definition (`.glossary__def`), which inside a ~550px column never
       reaches the cap anyway. */

    /* Height of the sticky A–Z strip, spelled out so every scroll offset below
       can derive from it: the chip rows (2rem each) + the <ul>'s focus-ring
       padding and the <nav>'s own padding (--space-1 each, four times) + the 1px
       keyline. Below 768px that is ONE row, because the strip scrolls sideways
       instead of wrapping. */
    --jump-bar-h: calc(2rem + 4 * var(--space-1) + var(--space-px));
  }

  @media (min-width: 768px) {
    .glossary {
      padding-block-start: var(--space-16);
      /* Two chip rows plus the row gap between them — see the bar rules below
         for why the wrapped strip is provably two rows and never three. */
      --jump-bar-h: calc(2 * 2rem + 5 * var(--space-1) + var(--space-px));
    }
  }

  /* The head is the only prose that spans the page, so it carries the measure. */
  .glossary__head {
    max-width: var(--measure);
  }

  .glossary__intro {
    margin-top: var(--space-4);
    font-size: var(--text-lg);
    color: var(--text-muted);
    line-height: var(--leading-relaxed);
  }

  .glossary__empty {
    margin-top: var(--space-8);
    color: var(--text-muted);
    font-style: italic;
  }

  /* ---- Jump-to-letter bar (design §1.3; spec §8) ----
     SPEC-GAP (M7.2): this REVERSES m5-design.md §1.3's "static <768px". The static
     bar sat at the very top of a ~12,000px page, so after any scroll both the
     letter nav AND the mobile "Top" chip that lived inside it were gone — the bar
     stopped existing exactly where a jump bar earns its keep. It is now sticky at
     every breakpoint (spec §8 was amended to match), and — per that same
     amendment — a single-row horizontally scrollable strip ON MOBILE ONLY: a
     wrapping bar is 3 rows at 375px, and pinning that much chrome eats a fifth of
     a phone viewport. Whatever the shape, --jump-bar-h above has to state the
     height exactly, because CSS cannot measure it: the old hardcoded ≥768px offset
     (7.75rem = 124px) landed letter headings ~26px UNDER the 86px two-row bar it
     was meant to clear (measured, 1280×900). */
  .glossary__jump {
    position: sticky;
    top: var(--header-h);
    z-index: 30; /* under the site header's 50 */
    margin-top: var(--space-8);
    background-color: var(--bg);
    padding-block: var(--space-1);
    border-bottom: 1px solid var(--border);
  }

  .glossary__jump ul {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    gap: var(--space-1);
    /* A scroll container clips BOTH axes, so without this padding the 2px focus
       ring (+2px offset) of a chip at either edge is sliced off. The matching
       negative inline margin keeps the chips flush with the page measure. */
    padding: var(--space-1);
    margin: 0 calc(-1 * var(--space-1));
    list-style: none;
    /* Reserve no room for a classic scrollbar: it would add ~15px of platform-
       dependent height to sticky chrome whose height every scroll-margin-top below
       depends on — and it is exactly that number this file cannot afford to guess.
       The ::after fade below carries the "this scrolls" affordance instead. */
    scrollbar-width: none;
    /* Runway the fade can sit over: the last --space-8 of the strip is tinted, so
       without this the reader who scrolls all the way to Z would read Z through
       it. With it, Z parks clear of the fade at the end of the scroll. */
    padding-inline-end: var(--space-8);
    /* Same --space-8, applied to every scroll-into-view: keyboard focus must not
       park a chip under the fade either. It also repairs a case that predates the
       fade — Chrome scrolls this strip in chunks on Tab and left "Q" 13px past the
       edge with its focus ring clipped (measured, 390×844). */
    scroll-padding-inline-end: var(--space-8);
  }

  .glossary__jump li {
    /* A chip is inline-level, so an ordinary <li> wraps it in a line box, and the
       line box adds leading below it as --text-sm clamps up: 0.75px per row at
       1280px, i.e. 1.5px of two-row bar that --jump-bar-h could not see. A flex
       <li> has no line box, so a row is the chip's 2rem and nothing else. */
    display: flex;
    flex: 0 0 auto; /* letters keep their 32px target instead of squashing */
  }

  /* The scrollbar is suppressed, so something else has to say the row continues.
     A trailing fade does it with no height of its own and no JS; it is purely
     decorative, so it is hidden from AT (a pseudo-element is) and never
     intercepts a pointer. The <nav> is `position: sticky`, which is already a
     containing block for this. */
  .glossary__jump::after {
    content: '';
    position: absolute;
    inset-block: 0;
    inset-inline-end: 0;
    width: var(--space-8);
    pointer-events: none;
    background-image: linear-gradient(to left, var(--bg), transparent);
  }

  /* ≥768px the strip goes back to the wrapping bar it was before M7.2 (spec §8
     scopes the scrollable row to mobile). Scrolling it here strands letters: 26
     chips are ~932px of content inside a column capped at --measure, so the last
     ~6 letters were unreachable on desktop with nothing to say so. Wrapping puts
     all 26 on screen, and the row count is derived rather than guessed: the column
     is ≥712px at 768px (viewport − 2 × --space-6 of page padding) and never wider
     than --measure (70ch, measured 729px), while a chip is 2rem on a 36px pitch —
     so every width ≥768px fits between 13 and 25 chips per row, i.e. exactly two
     rows. One row would need a 932px column, which --measure forbids; three would
     need one under 464px, which this breakpoint cannot produce. That is the "2 *"
     in --jump-bar-h. */
  @media (min-width: 768px) {
    .glossary__jump ul {
      flex-wrap: wrap;
      overflow-x: visible; /* no scroll container ⇒ focus rings are not clipped */
      padding-inline-end: var(--space-1);
    }

    .glossary__jump::after {
      content: none; /* nothing scrolls, so nothing to signal */
    }
  }

  .glossary__chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2rem;
    min-height: 2rem;
    padding-inline: var(--space-2);
    /* Reserved, not drawn: the hover below paints into this 1px so 26 chips
       never reflow under the pointer. Costs nothing at rest — box-sizing is
       border-box site-wide and the chip sits at its 2rem minimum either way,
       since its content is a single letter. */
    border: 1px solid transparent;
    border-radius: var(--radius-control);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--text);
    transition:
      background-color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard);
  }

  /* Hover, now on the same idiom every other filled-control hover in M7.3 uses
     (`.btn-secondary` in global.css, `.viz-btn` in Visualizer.astro): a
     `--brand-soft` fill plus a `--brand` edge.
     The edge is the half this chip used to lack. It hovered the LETTER to
     `--brand` instead, which was a signal only while `--brand` was a hue; Plan B
     made `--brand` byte-identical to `--text`, so that half silently became a
     no-op and left the fill carrying 26 targets by itself at 1.20:1 light /
     1.26:1 dark on the bar. That is under the 1.28:1 this comment already called
     barely-better when it rejected an earlier `--surface` fill as "no
     perceptible feedback at all" (that fill measured 1.05:1 / 1.28:1 on the
     pre-repaint palette and measures 1.03:1 / 1.08:1 on this one, so the
     judgement only got safer). The fill is therefore the reinforcement now and
     the border is the signal.
     `--brand`, not `--border-strong`: the latter measures 2.96:1 on the dark
     hover fill, below the 3:1 a keyline owes, while `--brand` is 14.86:1 light /
     12.90:1 dark against the fill and 17.77:1 / 16.20:1 against the bar behind
     it. The label does not move at all now and does not need to — `--text` is
     those same 17.77:1 / 16.20:1 at rest and 14.86:1 / 12.90:1 hovered.
     Scoped to `a.` on purpose: the empty letters are non-interactive `<span>`s
     and must never preview an affordance they do not have. */
  a.glossary__chip:hover {
    background-color: var(--brand-soft);
    border-color: var(--brand);
  }

  /* Empty letters: dimmed, non-interactive, non-focusable (aria-disabled + span,
     so Tab skips them). Dimming is a SECOND signal alongside aria-disabled — never
     color-only (design §1.3, §1.8). */
  .glossary__chip--empty {
    color: color-mix(in srgb, var(--text-muted) 55%, transparent);
    cursor: default;
  }

  /* ---- Filter (redesign 2026-08) ---- */
  .glossary__search {
    margin-top: var(--space-6);
    max-width: 30rem;
  }

  .glossary__search-label {
    display: block;
    margin-bottom: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  /* The border lives on the WRAPPER, not the input, so the icon and the clear
     button sit inside one control-shaped box and `:focus-within` can ring the
     whole thing — a ring around the bare input would cut through both. */
  .glossary__search-field {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding-inline: var(--space-3);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-control);
    background-color: var(--surface);
  }

  .glossary__search-field:focus-within {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset);
  }

  .glossary__search-icon {
    flex: none;
    color: var(--text-muted);
  }

  .glossary__search-input {
    flex: 1;
    min-width: 0;
    border: none;
    background: none;
    color: var(--text);
    font: inherit;
    padding-block: var(--space-2);
  }

  .glossary__search-input:focus {
    outline: none; /* the wrapper carries the ring — see :focus-within above */
  }

  /* Chrome and Safari draw their own clear affordance on type=search; ours is a
     real button with a label, and two of them side by side is one too many. */
  .glossary__search-input::-webkit-search-cancel-button {
    display: none;
  }

  .glossary__search-clear {
    flex: none;
    min-height: 32px;
    padding-inline: var(--space-2);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--text-muted);
  }

  .glossary__search-clear:hover {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .glossary__search-status {
    margin-top: var(--space-2);
    min-height: 1.5em; /* reserved, so a result count never shifts the list */
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .glossary__no-match {
    margin-top: var(--space-8);
    max-width: var(--measure);
    color: var(--text-muted);
    line-height: var(--leading-relaxed);
  }

  /* The strip keeps the reading measure even though the page no longer does.
     Its height is DECLARED (`--jump-bar-h` above) and every scroll offset on this
     page derives from that number, so how many rows the 26 chips wrap onto is
     load-bearing, not cosmetic: let them span 1152px and they collapse to one row,
     the token over-reports by 36px, and every in-page jump lands 36px low. Capping
     the nav is a one-line way to keep the declaration true — and a single hairline
     row of 26 letters spanning the full shell reads as a rule with letters on it
     rather than as an index. */
  .glossary__jump {
    max-width: var(--measure);
  }

  /* ---- Sections ---- */
  .glossary__sections {
    margin-top: var(--space-10);
  }

  /* TWO COLUMNS from 900px (redesign 2026-08). Forty-six definitions in one
     column made a 10,900px page whose right half was empty at every scroll
     position — a reference a reader scans rather than reads straight through,
     laid out as if they would read it straight through.

     Multi-column rather than grid, because a dictionary flows: grid rows would
     align every letter group to the tallest one in its row and open gaps between
     them. Column order is top-of-column-1 to bottom, then column 2, which is the
     order the A–Z already implies. `break-inside: avoid` keeps a letter group
     whole, so no heading is ever orphaned from its first term. */
  @media (min-width: 900px) {
    .glossary__sections {
      columns: 2;
      column-gap: var(--space-12);
    }

    .glossary__sections > section {
      break-inside: avoid;
      /* A column break resets nothing about margins, so the first group in
         column 2 would otherwise start with the top margin the flow gave it. */
      margin-top: 0;
    }
  }

  /* Every in-page jump target parks below the sticky chrome (design §1.4): the
     header plus the now-always-sticky letter strip, plus a little air. ONE rule
     for both breakpoints — both terms are responsive variables that state their
     own height (--header-h, --jump-bar-h), so the offset follows the strip from
     one scrollable row to two wrapped ones on its own. That replaces the
     4.5rem/7.75rem pair which had to be re-guessed per breakpoint, and got the
     ≥768px case wrong (see the bar comment above).
     `#top` keeps its offset even though the "Top" chip is gone: it is a page
     landmark that /glossary#top can still be linked to from anywhere. */
  .glossary section,
  .glossary__entry,
  #top {
    scroll-margin-top: calc(
      var(--header-h) + var(--jump-bar-h) + var(--space-2)
    );
  }

  .glossary section + section {
    margin-top: var(--space-12);
  }

  .glossary__letter {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    border-bottom: 1px solid var(--border);
    padding-bottom: var(--space-2);
  }

  .glossary__list {
    margin-top: var(--space-4);
  }

  .glossary__entry + .glossary__entry {
    margin-top: var(--space-6);
  }

  .glossary__term {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    color: var(--text);
  }

  .glossary__def {
    margin-inline-start: 0; /* reset default <dd> indent */
    max-width: var(--measure);
  }

  .glossary__def p {
    margin-top: var(--space-1);
    line-height: var(--leading-relaxed);
    color: var(--text);
  }

  /* Synonyms the lessons and the wider literature use. Rendering them is what lets
     find-in-page match "ring buffer" or "quicksort" on a page that ships no JS —
     text that is never in the DOM can never be searched. Selector is doubled so it
     beats `.glossary__def p`'s color, which would otherwise win on specificity. */
  .glossary__def .glossary__aliases {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .glossary__xref-line {
    margin-top: var(--space-1);
  }

  .glossary__xref {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--brand);
  }

  .glossary__xref:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>

<script>
  /**
   * Glossary filter (redesign 2026-08) — spec §19's deferred "glossary search
   * island", resolved.
   *
   * It filters MARKUP THAT IS ALREADY ON THE PAGE. There is no index, no fetch,
   * no store and no debounce timer: forty-six `data-haystack` strings are
   * compared with `includes` on every keystroke, which is well inside a frame,
   * and building an index would be more code than the search it serves.
   *
   * Progressive enhancement, in the site's usual shape: the form ships `hidden`
   * and this script reveals it, so a reader with JavaScript off — or with this
   * chunk still in flight — never meets a text field that cannot filter. The
   * complete A–Z list and its jump nav are what the page IS; the filter only
   * ever hides parts of it, and clearing the field restores every one.
   *
   * WHAT IT MATCHES: the term, its aliases, and its definition — composed at
   * build time into `data-haystack`, lowercased there so this runs no per-key
   * normalisation. Matching the definition is deliberate: a reader who half
   * remembers "the one about wrapping around" finds `Circular buffer`, which is
   * the case a term-only match would fail.
   *
   * The A–Z nav is HIDDEN while a filter is active, because its chips jump to
   * letters that may now be empty — a control that cannot do what it says is the
   * thing every kill-switch on this site exists to prevent.
   */
  const form = document.querySelector<HTMLElement>('[data-glossary-search]');
  const input = document.querySelector<HTMLInputElement>(
    '[data-glossary-input]',
  );
  const clear = document.querySelector<HTMLButtonElement>(
    '[data-glossary-clear]',
  );
  const status = document.querySelector<HTMLElement>('[data-glossary-status]');
  const noMatch = document.querySelector<HTMLElement>(
    '[data-glossary-nomatch]',
  );
  const jump = document.querySelector<HTMLElement>('[data-glossary-jump]');
  const sections = [
    ...document.querySelectorAll<HTMLElement>('[data-glossary-section]'),
  ];
  const entries = [
    ...document.querySelectorAll<HTMLElement>('[data-glossary-entry]'),
  ];

  if (form && input && clear && status && noMatch && entries.length > 0) {
    // The one thing that makes the control real. Everything below assumes it.
    form.hidden = false;

    /** "1 term" / "12 terms" — a count in words, never a ratio (calm invariant). */
    const termCount = (n: number): string => `${n} term${n === 1 ? '' : 's'}`;

    function apply(): void {
      const query = input!.value.trim().toLowerCase();
      clear!.hidden = query === '';

      if (query === '') {
        for (const entry of entries) entry.hidden = false;
        for (const section of sections) section.hidden = false;
        if (jump) jump.hidden = false;
        noMatch!.hidden = true;
        // Empty, not "46 terms": the resting state of the page is not news, and
        // announcing it on every clear would talk over the reader.
        status!.textContent = '';
        return;
      }

      let shown = 0;
      for (const entry of entries) {
        const hit = (entry.dataset['haystack'] ?? '').includes(query);
        entry.hidden = !hit;
        if (hit) shown += 1;
      }
      // A letter with nothing left to show goes too, heading and all.
      for (const section of sections) {
        section.hidden = !section.querySelector(
          '[data-glossary-entry]:not([hidden])',
        );
      }
      if (jump) jump.hidden = true;

      status!.textContent = `${termCount(shown)} matching “${input!.value.trim()}”`;
      noMatch!.hidden = shown > 0;
      if (shown === 0) {
        noMatch!.textContent = `Nothing matches “${input!.value.trim()}”. Try a shorter word — the filter looks at each term, its other names, and its definition.`;
      }
    }

    input.addEventListener('input', apply);
    clear.addEventListener('click', () => {
      input!.value = '';
      apply();
      input!.focus();
    });
    // Escape clears rather than blurring, which is what a reader who has filtered
    // themselves into a corner reaches for. `type="search"` gives Escape this
    // meaning natively in some browsers and not others; this makes it uniform.
    input.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && input!.value !== '') {
        event.preventDefault();
        input!.value = '';
        apply();
      }
    });
  }
</script>
