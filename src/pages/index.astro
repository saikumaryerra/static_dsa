---
/**
 * Home page (site spec §8 "Home page", M1 wireframe + M5 design §3 polish).
 *
 * Sections: hero (value prop + subhead + primary CTA to /learn + secondary link),
 * three feature blurbs (interactive / beginner-friendly / free), and two track
 * cards linking to /learn. Header/footer/skip-link come from BaseLayout.
 *
 * M5: the track-card counts, total minutes, difficulty spread, AND the "N lessons"
 * heading are DERIVED from the published lessons collection (design §3.5) — never
 * hardcoded, so they can never drift from the real curriculum. Optional site-level
 * WebSite JSON-LD is injected via the BaseLayout head slot (arch §3.3).
 */
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { webSiteJsonLd } from '../lib/structured-data';

const published = await getCollection('lessons', ({ data }) => data.published);
const totalLessons = published.length;

// WebSite JSON-LD (arch §3.3): static, zero client JS. Astro.site is always set.
const jsonLd = webSiteJsonLd(Astro.site!);

interface Feature {
  title: string;
  body: string;
  /** Inline 24px stroke icon path data (drawn by hand — no icon library, spec §4). */
  iconPaths: string[];
}

const features: Feature[] = [
  {
    title: 'Interactive by default',
    body: 'Every lesson is built around a visualization you control: play, pause, step forward and back, or run the algorithm on your own input.',
    // Play button in a circle — "press play on the algorithm".
    iconPaths: [
      'M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z',
      'M10 8l6 4-6 4V8z',
    ],
  },
  {
    title: 'Made for beginners',
    body: 'Plain language, concrete examples, and every term defined the first time it appears. Start from zero and build up one lesson at a time.',
    // Open book.
    iconPaths: [
      'M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z',
      'M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z',
    ],
  },
  {
    title: 'Free, forever',
    body: 'No account, no paywall, no tracking. The whole site is static and open source, and every lesson works offline once loaded.',
    // Heart.
    iconPaths: [
      'M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z',
    ],
  },
];

interface Track {
  id: 'foundations' | 'algorithms';
  label: string;
  title: string;
  summary: string;
}

/** Static presentation for each track; counts/minutes/spread are derived below. */
const trackDefs: Track[] = [
  {
    id: 'foundations',
    label: 'Track A',
    title: 'Foundations & Data Structures',
    summary:
      'Big-O, arrays, linked lists, stacks, queues, hash tables, trees, heaps, and graphs — the building blocks every algorithm relies on.',
  },
  {
    id: 'algorithms',
    label: 'Track B',
    title: 'Algorithms',
    summary:
      'Recursion, binary search, the classic sorts, and graph traversal — watch each one run step by step until it clicks.',
  },
];

/**
 * Human-readable difficulty spread for a track's lessons (design §3.5) — e.g.
 * "8 beginner · 1 intermediate" or "All beginner". Difficulty as words (never a
 * color-only chip) keeps it accessible (§3.8, WCAG 1.4.1).
 */
function difficultySpread(lessons: CollectionEntry<'lessons'>[]): string {
  const counts = { beginner: 0, intermediate: 0 };
  for (const l of lessons) counts[l.data.difficulty]++;
  const parts = (['beginner', 'intermediate'] as const)
    .filter((d) => counts[d] > 0)
    .map((d) => `${counts[d]} ${d}`);
  // A single-difficulty track reads "All beginner" rather than "9 beginner".
  return parts.length === 1
    ? `All ${parts[0].split(' ')[1]}`
    : parts.join(' · ');
}

// Derive per-track meta from the collection: count, minutes (summed, rounded to
// the nearest 5), and the difficulty spread — anti-drift (design §3.5).
const tracks = trackDefs.map((def) => {
  const lessons = published.filter((l) => l.data.track === def.id);
  const minutes = lessons.reduce((sum, l) => sum + l.data.estimatedMinutes, 0);
  const roundedMinutes = Math.round(minutes / 5) * 5;
  return {
    ...def,
    count: lessons.length,
    totalMinutes: roundedMinutes,
    spread: difficultySpread(lessons),
  };
});
---

<BaseLayout
  title="LearnDSA — see data structures and algorithms in motion"
  description="Free, interactive lessons on data structures and algorithms. Play, pause, and step through every swap, pointer move, and recursive call — on your own input."
  canonicalPath="/"
>
  <script type="application/ld+json" slot="head" set:html={jsonLd} is:inline />

  <!-- Hero: left-aligned per wireframe (center-aligned rag breaks with longer
       strings). H1 balances + caps at 20ch to avoid ragged breaks (design §3.2). -->
  <section class="py-16 md:pt-24 md:pb-20">
    <h1 class="max-w-[20ch] text-4xl font-bold text-balance">
      See data structures and algorithms in motion
    </h1>
    <p class="mt-5 max-w-[55ch] text-lg text-muted">
      LearnDSA teaches the core of computer science with interactive,
      step-by-step visualizations. Watch every swap, pointer move, and recursive
      call happen — then run each algorithm on your own input.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <a href="/learn" class="btn-primary">Start learning</a>
      {
        /* Secondary stays a TEXT link (one clear primary); min-height 44px +
           inline-flex aligns it to the button's baseline on the shared row
           (design §3.3). Arrow in its own span so translations never bake it in. */
      }
      <a
        href="/about"
        class="inline-flex min-h-[44px] items-center font-medium text-brand hover:underline"
      >
        How it works <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <!-- Feature blurbs: borderless, whitespace-separated (editorial, not dashboard). -->
  <section class="mt-16 md:mt-24">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-3 md:gap-8">
      {
        features.map((feature) => (
          <div>
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-brand"
              aria-hidden="true"
            >
              {feature.iconPaths.map((d) => (
                <path d={d} />
              ))}
            </svg>
            <h2 class="mt-4 text-lg font-semibold">{feature.title}</h2>
            <p class="mt-2 text-base text-muted">{feature.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Track cards: whole card is one link (wireframe). Count + meta data-driven. -->
  <section class="mt-16 md:mt-24">
    <h2 class="mb-6 text-2xl font-bold">Two tracks, {totalLessons} lessons</h2>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      {
        tracks.map((track) => (
          <a href={`/learn#track-${track.id}`} class="track-card">
            <p class="text-xs tracking-[0.06em] text-muted uppercase">
              {track.label}
            </p>
            <h3 class="mt-2 text-xl font-semibold text-text">{track.title}</h3>
            <p class="mt-2 text-base text-muted">{track.summary}</p>
            <p class="mt-4 text-sm text-muted tabular-nums">
              {track.count} lessons · ~{track.totalMinutes} min · {track.spread}{' '}
              <span aria-hidden="true">→</span>
            </p>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
