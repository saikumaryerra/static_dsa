---
/**
 * Home page (site spec §8, M1 wireframe, M5 design §3, M7.3 hero — rebuilt in the
 * 2026-08 redesign).
 *
 * WHAT CHANGED AND WHY. The page used to open with a still: a frozen frame of
 * binary search, produced by the real renderer so it could never drift, with
 * "Play it in the lesson →" underneath. It was honest and it was the wrong
 * artifact. A product whose entire claim is *you can step through this* opened
 * by showing a photograph of stepping through it, and asked the visitor to
 * navigate twice before the claim could be checked. The hero now mounts the REAL
 * instrument — the same `<Visualizer>` island a lesson uses, on the same trace —
 * so the first thing a stranger can do on this site is press Play.
 *
 * That deleted about 130 lines from this file: the `renderStatic` call, the
 * frame-picking derivation, the build-time assertion that the renderer still
 * emits nine class names, and the ~110 lines of `.hero-demo__canvas :global(…)`
 * CSS that restated the renderer's stylesheet because the still was drawn
 * outside the island that owns it. All of it existed to keep a hand-placed copy
 * of the product in step with the product. Mounting the product needs none of it.
 *
 * Sections, each with one job:
 *   hero        what this is + the thing itself, running
 *   lesson      what a lesson gives you, described in terms of the hero above it
 *   curriculum  every lesson, by track — the scope of the thing, and 15 doors in
 *   candour     what it costs and what it takes from you (both nothing)
 *   close       one last way in
 *
 * The track counts, minutes, difficulty spread and the lesson lists are all
 * DERIVED from the published collection (M5 design §3.5), so they can never
 * drift from the real curriculum. Nothing on this page is fabricated: there are
 * no testimonials, ratings, user counts or logos, because the product has never
 * been publicly measured and inventing one would be the worst thing this page
 * could do (PRODUCT.md, "Evidence on Hand").
 */
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Visualizer from '../viz/Visualizer.astro';
import { webSiteJsonLd } from '../lib/structured-data';
import { resumeLabel, type LessonRef } from '../lib/progress';
import { TRACK_ORDER, TRACK_COPY } from '../lib/tracks';

const published = await getCollection('lessons', ({ data }) => data.published);
const totalLessons = published.length;

// WebSite JSON-LD (arch §3.3): static, zero client JS. Astro.site is always set.
const jsonLd = webSiteJsonLd(Astro.site!);

/**
 * What one lesson actually gives a reader. Three claims, each about something
 * visible in the hero instrument directly above them rather than about the
 * product in the abstract — "step forward and back" is a button they can already
 * see, and "the run written out as a table" is the table under the drawing.
 */
const promises = [
  {
    title: 'Step it, forwards and back',
    body: 'The drawing above is not an animation. An instrumented algorithm ran once and recorded every step, so the player is just an index into that record — which is why stepping backwards is instant, and why it is always the truth.',
  },
  {
    title: 'Read the same run as a table',
    body: 'Under every drawing is the run written out, one row per step, with the algorithm’s own variables as columns. Two views of one trace: they cannot tell you different stories, and with JavaScript off the table is the lesson.',
  },
  {
    title: 'Run it on your own numbers',
    body: 'Type an array and press Run. The algorithm executes on your input for real and the drawing, the table and the step count all follow — no canned second example, nothing pre-recorded.',
  },
];

/**
 * Human-readable difficulty spread for a track's lessons (M5 design §3.5) — e.g.
 * "8 beginner · 1 intermediate" or "All beginner". Difficulty as words (never a
 * color-only chip) keeps it accessible (§3.8, WCAG 1.4.1).
 */
function difficultySpread(lessons: CollectionEntry<'lessons'>[]): string {
  const counts = { beginner: 0, intermediate: 0 };
  for (const l of lessons) counts[l.data.difficulty]++;
  const parts = (['beginner', 'intermediate'] as const)
    .filter((d) => counts[d] > 0)
    .map((d) => `${counts[d]} ${d}`);
  // A single-difficulty track reads "All beginner" rather than "9 beginner".
  return parts.length === 1
    ? `All ${parts[0].split(' ')[1]}`
    : parts.join(' · ');
}

/**
 * The two tracks with their real contents. The home page used to show a
 * paragraph *about* each track; it now shows the lessons themselves, because a
 * visitor deciding whether this site covers what they came for should not have
 * to take a summary's word for it, and because fifteen named links are fifteen
 * ways in for the reader who arrived wanting exactly one of them.
 */
const tracks = TRACK_ORDER.map((id) => {
  const lessons = published
    .filter((l) => l.data.track === id)
    .sort((a, b) => a.data.order - b.data.order);
  const minutes = lessons.reduce((sum, l) => sum + l.data.estimatedMinutes, 0);
  return {
    id,
    ...TRACK_COPY[id],
    lessons,
    count: lessons.length,
    totalMinutes: Math.round(minutes / 5) * 5,
    spread: difficultySpread(lessons),
  };
});

/**
 * The lesson list the hero's continue line reads (M7.2 progress system), in
 * global order. Injected from the BUILD as JSON — localStorage is never
 * enumerated by prefix, so a renamed or unpublished lesson can never leave a
 * stale key that points the reader at a 404.
 */
const lessonRefs: LessonRef[] = published
  .map(({ data }) => ({
    slug: data.slug,
    title: data.title,
    order: data.order,
    track: data.track,
  }))
  .sort((a, b) => a.order - b.order);

/** First lesson in global order — the JS-off / nothing-stored destination. */
const firstLesson = lessonRefs[0];

/**
 * The continue line's server-rendered wording, from the same helper the island
 * calls at runtime (with "nothing complete yet" as the only honest build-time
 * assumption) so the two can never word the same state differently.
 */
const resumeFallback = firstLesson
  ? resumeLabel(firstLesson, 0, lessonRefs.length)
  : '';

/** Two-digit lesson number, matching the curriculum cards. */
const num = (order: number) => String(order).padStart(2, '0');
---

<BaseLayout
  title="LearnDSA — see data structures and algorithms in motion"
  description="Free, interactive lessons on data structures and algorithms. Play, pause, and step through every swap, pointer move, and recursive call — on your own input."
  canonicalPath="/"
  wide
>
  <script type="application/ld+json" slot="head" set:html={jsonLd} is:inline />

  <!-- Hero: copy left, the real instrument right from 1024px; stacked below it.
       Left-aligned per wireframe (a centred rag breaks with longer strings). -->
  <section class="hero">
    <div class="hero__copy">
      <h1 class="hero__title">See data structures and algorithms in motion</h1>
      <p class="hero__lede">
        Fifteen lessons that teach the core of computer science by showing you
        the algorithm running. Every swap, pointer move and recursive call, one
        step at a time — on your own input, in your own browser.
      </p>
      <div class="hero__actions">
        <a
          href={firstLesson ? `/learn/${firstLesson.slug}` : '/learn'}
          class="btn-primary"
        >
          Start with lesson 01
        </a>
        {
          /* Secondary stays a TEXT link (one clear primary); min-height 44px +
             inline-flex aligns it to the button's baseline on the shared row
             (M5 design §3.3). Arrow in its own span so translations never bake
             it into the label. */
        }
        <a href="/learn" class="hero__secondary">
          See all {totalLessons} lessons <span aria-hidden="true">→</span>
        </a>
      </div>

      {
        /* Continue line (M7.2, amended by the redesign). It used to ship VISIBLE
           and server-rendered pointing at lesson 01, so a JS-off reader still had
           a true link. The primary CTA above now says exactly that — "Start with
           lesson 01" — so on a first visit the two said the same thing twice, one
           under the other. A returning reader is the only person this line has
           anything to tell, so it ships `hidden` and the island reveals it only
           once it can see at least one completed lesson on this device.

           Nothing is lost with JavaScript off or with storage blocked: the line
           stays hidden and the CTA above is the same destination it would have
           offered. The server-rendered text is still the real wording from
           `resumeLabel`, so the reveal cannot flash a different sentence. */
      }
      {
        firstLesson && (
          <p
            class="hero__resume"
            data-lessons={JSON.stringify(lessonRefs)}
            data-resume-root
            hidden
          >
            <a
              href={`/learn/${firstLesson.slug}`}
              class="hero__resume-link"
              data-resume-link
            >
              <span data-resume-label>{resumeFallback}</span>
              <span aria-hidden="true">→</span>
            </a>
            {/* All-complete state: no honest "next" destination, so the link
                stands down for a plain line. Revealed by the island only. */}
            <span data-resume-done hidden />
          </p>
        )
      }
    </div>

    {
      /* THE PRODUCT, NOT A PICTURE OF IT. This is the same island, algorithm and
         renderer the binary-search lesson mounts, so nothing here can drift from
         what a lesson does — it is not "kept in sync", it is the same code.

         Two props are set against their defaults. `allowCustomInput={false}`:
         the custom-input form is the one control that needs its own explanation
         (formats, caps, a target field), and the hero's job is to get a stranger
         to press Play, not to teach an input grammar — the lesson two clicks away
         does that, and the third promise below says so in words. `showLedger`
         stays on, because the table under the drawing IS the argument this page
         is making. */
    }
    <div class="hero__stage">
      <Visualizer
        algorithm="binary-search"
        renderer="array"
        input="[1,3,5,7,9,11] target=7"
        allowCustomInput={false}
      />
      <p class="hero__stage-note">
        The real lesson visualization, running here. <a
          href="/learn/binary-search"
          >Open the lesson <span aria-hidden="true">→</span></a
        >
      </p>
    </div>
  </section>

  <!-- What a lesson gives you. Borderless and whitespace-separated (editorial,
       not dashboard), and each claim is about the instrument directly above. -->
  <section class="promises" aria-labelledby="promises-heading">
    <h2 id="promises-heading" class="section-heading">
      What a lesson actually does
    </h2>
    <div class="promises__grid">
      {
        promises.map((promise) => (
          <div class="promise">
            <h3 class="promise__title">{promise.title}</h3>
            <p class="promise__body">{promise.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- The curriculum itself: two tracks, every lesson named and linked. -->
  <section class="curriculum" aria-labelledby="curriculum-heading">
    <div class="curriculum__head">
      <h2 id="curriculum-heading" class="section-heading">
        {totalLessons} lessons, two tracks
      </h2>
      <p class="curriculum__intro">
        Work through them in order, or start at whichever one you came for —
        nothing is locked, and every lesson names what it builds on.
      </p>
    </div>
    <div class="curriculum__tracks">
      {
        tracks.map((track) => (
          <div class="track">
            <h3 class="track__title">
              <a href={`/learn#track-${track.id}`}>{track.heading}</a>
            </h3>
            <p class="track__meta tabular-nums">
              {track.count} lessons · ~{track.totalMinutes} min · {track.spread}
            </p>
            <ol class="track__list" role="list">
              {track.lessons.map((lesson) => (
                <li>
                  <a href={`/learn/${lesson.data.slug}`} class="track__lesson">
                    <span class="track__num tabular-nums" aria-hidden="true">
                      {num(lesson.data.order)}
                    </span>
                    <span class="track__name">{lesson.data.title}</span>
                    <span class="track__mins tabular-nums">
                      {lesson.data.estimatedMinutes} min
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Candour. These are the product's own non-promises, stated plainly rather
       than buried — PRODUCT.md calls that candour part of the identity, and it
       is also the honest answer to "what is the catch". Nothing here is a claim
       about popularity or quality, because there is no evidence for one. -->
  <section class="candour" aria-labelledby="candour-heading">
    <h2 id="candour-heading" class="section-heading">What it costs you</h2>
    <dl class="candour__list">
      <div>
        <dt>No account, no paywall</dt>
        <dd>
          Every lesson is open on the first visit. There is nothing to sign up
          for, because there is no server to sign up to.
        </dd>
      </div>
      <div>
        <dt>No tracking, no cookies</dt>
        <dd>
          Nothing is measured and nothing is sent anywhere. The site makes no
          network calls at all once a page has loaded.
        </dd>
      </div>
      <div>
        <dt>Progress stays on this device</dt>
        <dd>
          What you finish is remembered in this browser only — never synced,
          never uploaded. Clearing your browser data clears it.
        </dd>
      </div>
      <div>
        <dt>Works offline, and without JavaScript</dt>
        <dd>
          A loaded lesson keeps working with no connection. With scripts blocked
          the prose, the code and the written-out run are all still there.
        </dd>
      </div>
    </dl>
  </section>

  <section class="close">
    <h2 class="close__title">Start where the rest of it builds from.</h2>
    {
      firstLesson && (
        <a href={`/learn/${firstLesson.slug}`} class="btn-primary">
          Begin: {num(firstLesson.order)} · {firstLesson.title}
        </a>
      )
    }
  </section>
</BaseLayout>

<style>
  /* ---- Shared section rhythm ----
     One vertical scale for the whole page, so the gaps between sections read as
     a system rather than as four independent decisions. */
  .promises,
  .curriculum,
  .candour,
  .close {
    margin-top: var(--space-20);
  }

  @media (min-width: 768px) {
    .promises,
    .curriculum,
    .candour,
    .close {
      margin-top: var(--space-24);
    }
  }

  .section-heading {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tight);
  }

  /* ---- Hero ---- */
  .hero {
    display: grid;
    gap: var(--space-10);
    padding-block: var(--space-12) 0;
  }

  /* Two columns only where the instrument still has room to be legible. Below
     1024px it stacks under the CTA row, separated by the ordinary grid gap
     rather than any extra hero padding — the mobile hero must not regrow a dead
     band (M7.1 RSP-6). `start` so the copy sits at the top of a tall
     instrument instead of floating in the middle of it. */
  @media (min-width: 1024px) {
    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 30rem);
      /* Centred, not `start`: the instrument is roughly twice the height of the
         copy, and top-aligning left a 350px hole under the CTA row that read as
         an unfinished column rather than as breathing room. */
      align-items: center;
      gap: var(--space-12);
      padding-block: var(--space-16) 0;
    }
  }

  @media (min-width: 1280px) {
    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 34rem);
    }
  }

  /* The one display-tier heading on the site (M7.3): --text-5xl, --weight-heavy
     and --tracking-tighter are a set, and no other page may use them. Capped at
     18ch so the rag breaks where the meaning does. */
  .hero__title {
    max-width: 18ch;
    font-size: var(--text-5xl);
    font-weight: var(--weight-heavy);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tighter);
    text-wrap: balance;
  }

  .hero__lede {
    margin-top: var(--space-5);
    max-width: 46ch;
    font-size: var(--text-lg);
    color: var(--text-muted);
    line-height: var(--leading-relaxed);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  .hero__secondary {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: var(--space-1);
    font-weight: var(--weight-medium);
    color: var(--brand);
  }

  .hero__secondary:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .hero__resume {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .hero__resume-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: var(--space-1);
    font-weight: var(--weight-medium);
    color: var(--brand);
  }

  .hero__resume-link:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* The instrument's own full-bleed negative margin (RSP-2) is right inside a
     lesson's reading column and wrong here, where the hero column already has
     the page gutter. Cancel it at the widths where the hero is one column; the
     `.viz` rule restores its own margins from 768px up anyway. */
  .hero__stage :global(.viz) {
    margin-block-start: 0;
  }

  .hero__stage-note {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .hero__stage-note a {
    color: var(--brand);
    font-weight: var(--weight-medium);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* ---- What a lesson does ---- */
  .promises__grid {
    display: grid;
    gap: var(--space-8);
    margin-top: var(--space-8);
  }

  @media (min-width: 768px) {
    .promises__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-10);
    }
  }

  .promise__title {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
  }

  .promise__body {
    margin-top: var(--space-2);
    color: var(--text-muted);
    line-height: var(--leading-relaxed);
  }

  /* ---- Curriculum ---- */
  .curriculum__intro {
    margin-top: var(--space-3);
    max-width: 60ch;
    color: var(--text-muted);
    line-height: var(--leading-relaxed);
  }

  .curriculum__tracks {
    display: grid;
    gap: var(--space-10);
    margin-top: var(--space-8);
  }

  @media (min-width: 900px) {
    .curriculum__tracks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-12);
      align-items: start;
    }
  }

  .track__title {
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
  }

  .track__title a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .track__meta {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .track__list {
    margin-top: var(--space-4);
    list-style: none;
    padding: 0;
    /* A hairline between rows rather than a card each: fifteen cards would make
       the curriculum look like a shop, and the list is already a list. */
    border-top: 1px solid var(--border);
  }

  .track__list li {
    border-bottom: 1px solid var(--border);
  }

  /* The whole row is the target, and it clears 44px (WCAG 2.5.5) without a
     card's worth of padding. Grid rather than flex so the numbers, the names
     and the minutes each hold their own column across every row. */
  .track__lesson {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    min-height: 44px;
    padding-block: var(--space-2);
    color: var(--text);
    transition: background-color var(--duration-fast) var(--ease-standard);
  }

  /* Fill AND underline, never colour alone: the achromatic chrome leaves the
     fill move nearly invisible on its own (M7.3), so hover carries two signals
     exactly as `.btn-secondary` and the collapsed disclosure rows do. */
  .track__lesson:hover {
    background-color: var(--brand-soft);
  }

  .track__lesson:hover .track__name {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .track__num {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-muted);
    padding-inline-start: var(--space-2);
  }

  .track__mins {
    font-size: var(--text-sm);
    color: var(--text-muted);
    padding-inline-end: var(--space-2);
  }

  /* ---- Candour ---- */
  .candour__list {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  @media (min-width: 768px) {
    .candour__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-8) var(--space-12);
    }
  }

  .candour__list dt {
    font-weight: var(--weight-semibold);
  }

  .candour__list dd {
    margin-top: var(--space-1);
    max-width: 46ch;
    color: var(--text-muted);
    line-height: var(--leading-relaxed);
  }

  /* ---- Close ---- */
  .close {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
    padding-top: var(--space-12);
    border-top: 1px solid var(--border);
  }

  .close__title {
    max-width: 22ch;
    font-size: var(--text-3xl);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
  }
</style>

<script>
  /**
   * Hero continue line (M7.2). The only thing this island does is rewrite one
   * already-useful link: server-side it reads "Start with 01 · …", and once it
   * can see this device's `lesson:{slug}:complete` keys it becomes
   * "Continue: NN · …", or stands down for "All N done — revisit any lesson."
   *
   * The primary CTA above is deliberately untouched — a first-time visitor must
   * always meet the same hero. All storage access goes through
   * `src/lib/progress.ts` (one module, one try/catch discipline), so a blocked
   * store simply leaves the server-rendered line in place.
   */
  import {
    nextIncomplete,
    onRestore,
    parseLessonRefs,
    readCompleted,
    resumeLabel,
  } from '../lib/progress';

  function render(): void {
    const host = document.querySelector<HTMLElement>('[data-lessons]');
    const list = parseLessonRefs(host?.dataset['lessons']);
    if (list.length === 0) return; // no injected list: leave the fallback alone

    const root = document.querySelector<HTMLElement>('[data-resume-root]');
    const link =
      document.querySelector<HTMLAnchorElement>('[data-resume-link]');
    const label = document.querySelector<HTMLElement>('[data-resume-label]');
    const done = document.querySelector<HTMLElement>('[data-resume-done]');
    if (!root || !link || !label || !done) return;

    const next = nextIncomplete(list);
    const completed = readCompleted(list).length;
    // Nothing finished on this device: there is nothing to resume, and the
    // primary CTA above already offers lesson 01. Staying hidden is the whole
    // behaviour — this is also the state a reader returns to after using the
    // reset control, so the line has to be able to go back to it.
    root.hidden = completed === 0;
    if (completed === 0) return;

    const text = resumeLabel(next, completed, list.length);
    if (next) {
      link.href = `/learn/${next.slug}`;
      label.textContent = text;
      done.hidden = true;
      link.hidden = false;
    } else {
      done.textContent = text;
      done.hidden = false;
      link.hidden = true;
    }
  }

  render();
  // Re-read after a back/forward-cache restore: the home page is exactly what a
  // reader lands back on after finishing a lesson, and that path runs no script,
  // so the line would still name the lesson they just completed. (The
  // astro:page-load hook covers View Transitions if a ClientRouter is ever
  // added; none is installed today.)
  onRestore(render);
  document.addEventListener('astro:page-load', render);
</script>
