---
/**
 * 404 — friendly not-found page (spec §8; M5 architecture §2.4).
 *
 * Prerendered to `dist/404.html` (static output). Marked `noindex` via the head
 * slot so crawlers never index the error page; its canonical points at "/" (the
 * page has no meaningful URL of its own). One <h1>, routes to /learn and home.
 * The lesson index is the primary action (M7.1 IA-8) because nearly every
 * guessable deep URL that lands here is a mistyped lesson slug.
 *
 * M7.3 VD-7 adds the brand moment below the actions — see the demo block. The
 * left-edge alignment stays: centring this page was CONSIDERED AND REJECTED
 * (design-tokens-m1.md's documented left-aligned measure), so the SVG is the
 * only change here.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { algorithms, renderers } from '../viz/registry';
import type { Algorithm, RendererModule } from '../viz/core/types';

/**
 * ── "Target not found" (M7.3 VD-7) ────────────────────────────────────────────
 *
 * The page was a grey number floating in whitespace. It now ends on the site's
 * own visual language: a real binary search for 404 in a sorted list of HTTP
 * status codes — which does not contain it — rendered at its FINAL step, where
 * the search window has collapsed to nothing and every cell is ruled out.
 *
 * Built exactly like the hero demo and the lesson still (architecture §1): page
 * frontmatter runs at build time, so it awaits the same lazy registry thunks,
 * runs the real algorithm, and asks the real renderer for a DOM-free SVG string.
 * Zero client JS; works with JS off; nothing about the drawing is hand-authored.
 */
const NOT_FOUND_INPUT = '[200,301,400,403,410,500] target=404';

const searchAlgorithm: Algorithm<unknown, unknown> =
  await algorithms['binary-search']();
const arrayRenderer: RendererModule<unknown> = await renderers.array();
const searchInput = searchAlgorithm.parseInput(NOT_FOUND_INPUT);
if (searchInput && typeof searchInput === 'object' && 'error' in searchInput) {
  throw new Error(
    `404 demo input rejected: ${(searchInput as { error: string }).error}`,
  );
}
const searchTrace = searchAlgorithm.run(searchInput);
const lastStep = searchTrace[searchTrace.length - 1]!;

/**
 * The joke only works while 404 is genuinely absent: a present target makes the
 * final step a `found` frame with a ✓ on it, which would contradict every word
 * on this page. Assert the collapsed-window shape (no highlights left) rather
 * than trust the literal above — editing the array is then a build failure, not
 * a silent contradiction. The class list guards the local `<style>` the same way
 * the hero's does: these are the renderer's classes, restated here because the
 * visualizer's global stylesheet only ships on pages that mount the island.
 */
if ((lastStep.highlights ?? []).length > 0) {
  throw new Error(
    `404 demo: the final step still highlights something — ${NOT_FOUND_INPUT} must search for a target the array does not contain.`,
  );
}
const notFoundStill = arrayRenderer.renderStatic(lastStep, {
  title: searchAlgorithm.label,
  idBase: 'nf-demo',
});
const missingClasses = [
  'viz-cell__rect',
  'viz-cell__value',
  'viz-cell__index',
  'is-eliminated',
].filter((cls) => !notFoundStill.includes(cls));
if (missingClasses.length > 0) {
  throw new Error(
    `404 demo still no longer emits: ${missingClasses.join(', ')}. The renderer's class contract changed — update this page's styles with it.`,
  );
}
---

<BaseLayout
  title="Page not found · LearnDSA"
  description="This page doesn't exist. Head back to the home page or browse the lessons."
  canonicalPath="/"
>
  <meta name="robots" content="noindex" slot="head" />

  <section class="notfound">
    <p class="notfound__code" aria-hidden="true">404</p>
    <h1>Page not found</h1>
    <p class="notfound__body">
      The page you're looking for doesn't exist or may have moved.
    </p>
    <div class="notfound__actions">
      <a href="/learn" class="btn-primary">Browse the lessons</a>
      <a href="/" class="font-medium text-brand hover:underline">Back to home</a
      >
    </div>

    {
      /* Below the actions, so M7.1's CTA emphasis is untouched: the reader meets
         the error, the explanation and the primary button before the flourish.
         The canvas is aria-hidden because the caption states the algorithm, the
         input and the step's own explanation verbatim — exposing the SVG's
         identical <desc> too would just announce it twice. */
    }
    <figure class="notfound__demo">
      <div
        class="notfound__canvas"
        aria-hidden="true"
        set:html={notFoundStill}
      />
      <figcaption class="notfound__caption">
        <b>Binary search for 404</b> in a sorted list of HTTP status codes.
        <span class="notfound__step">{lastStep.explanation}</span>
      </figcaption>
    </figure>
  </section>
</BaseLayout>

<style>
  .notfound {
    padding-block: var(--space-16) var(--space-20);
    max-width: var(--measure);
  }

  .notfound__code {
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    color: var(--text-muted);
  }

  .notfound h1 {
    margin-top: var(--space-2);
  }

  .notfound__body {
    margin-top: var(--space-4);
    font-size: var(--text-lg);
    color: var(--text-muted);
    line-height: var(--leading-relaxed);
  }

  .notfound__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  /* ---- Brand moment (M7.3 VD-7) ----
     Elevation level 1 (the model in global.css): 1px `--border` keyline + a
     resting `--shadow-1`, over the `--brand-soft` fill this phase's panels
     share. It rests there and stays there: this figure is not interactive — no
     link, no control — so it takes no hover or pressed promotion. A panel that
     lit up under the pointer would be advertising an affordance it does not
     have, which is the same rule M7.1 CMP-3 applies to disabled controls.

     The keyline is `--border`, NOT `--brand-border`: tokens.css declares that
     token decorative (1.49:1 on `--surface`) and it was the only thing drawing
     this panel's edge. `--border` is decorative too (1.18:1 light / 1.81:1 dark
     against the canvas) and that is the right job for it here — the panel is
     identified by its tinted fill and its shadow, exactly as `.track-card` is,
     with the keyline as the finish rather than the boundary. */
  .notfound__demo {
    margin: var(--space-12) 0 0;
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background-color: var(--brand-soft);
    box-shadow: var(--shadow-1);
  }

  .notfound__caption {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--text);
  }

  .notfound__step {
    display: block;
    margin-top: var(--space-1);
    color: var(--text-muted);
  }

  /* The still's own classes, restated from `src/viz/Visualizer.astro`'s
     `is:global` block — that stylesheet ships only on pages that mount the
     island. Token values are identical to the lesson's with ONE deliberate
     delta, `is-eliminated`, documented at its rule below; the transitions are
     dropped (a static frame never tweens), and the frontmatter fails the build
     if the renderer stops emitting any class named here. The `px` sizes are SVG
     user units inside the viewBox and scale with the drawing. */
  .notfound__canvas :global(.viz-cell__rect) {
    fill: var(--surface);
    stroke: var(--border-strong);
    stroke-width: 1.5;
  }

  .notfound__canvas :global(.viz-cell__value) {
    fill: var(--text);
    font-family: var(--font-mono);
    font-size: 20px;
    font-weight: var(--weight-semibold);
  }

  .notfound__canvas :global(.viz-cell__index) {
    fill: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  /* The one delta from the lesson's stylesheet, and the reason is this frame:
     the search has collapsed, so EVERY cell is `is-eliminated` and the lesson's
     whole-cell `opacity: 0.42` would paint the entire drawing at 42% — the
     numerals landing at 2.77:1 light / 3.32:1 dark against their own cells and
     the piece reading as a disabled or half-loaded widget rather than a
     flourish. A uniform wash also carries no information: dimming is only
     meaningful when something ELSE is live, which is why the home hero (a
     mid-run frame) keeps the wholesale dim and this one does not.

     So the same 0.42 is scoped to the box: `fill-opacity` washes out the cell's
     FILL and leaves its stroke and its text alone. The cells still read as
     ruled out, and everything stays legible — `--text` numerals 16.74:1 light /
     11.85:1 dark on the washed fill, `--text-muted` index labels 7.11:1 /
     5.70:1, and the `--border-strong` cell edge 4.46:1 / 3.07:1, so the
     boundary clears 1.4.11's 3:1 in both themes too.

     Picking a mid-run step with a live cell instead was the other way out, and
     it was rejected: the collapsed frame IS the joke, the caption quotes that
     step's own explanation verbatim, and the frontmatter above asserts the
     shape. */
  .notfound__canvas :global(.viz-cell.is-eliminated .viz-cell__rect) {
    fill-opacity: 0.42;
  }

  /* ---- Forced colors / Windows High Contrast ----
     HCM-1's hardening lives in the Visualizer island's `is:global` block, which
     ships only on pages that mount the island — this still is rendered outside
     it, so it needs its own. Same contract as the lesson's: forced colours
     override author `fill`/`stroke`, so repaint in SYSTEM colours, which this
     mode does not override. Minimal on purpose: one decorative frame owes
     legible numerals and a visible cell boundary, and there is no state left to
     encode — every cell in this step is in the same one. The wash goes with it,
     because a forced palette has no shades to spend and the cells still have to
     be readable. */
  @media (forced-colors: active) {
    .notfound__canvas :global(.viz-cell__rect) {
      fill: Canvas;
      stroke: CanvasText;
    }

    .notfound__canvas :global(.viz-cell.is-eliminated .viz-cell__rect) {
      fill-opacity: 1;
    }

    .notfound__canvas :global(.viz-cell__value),
    .notfound__canvas :global(.viz-cell__index) {
      fill: CanvasText;
    }
  }
</style>
