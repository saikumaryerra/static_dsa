---
/**
 * LessonLayout — wraps a rendered lesson's MDX body (design §1, site spec §8).
 *
 * Props:
 * - `title`, `summary`, `difficulty`, `track`, `estimatedMinutes` — frontmatter.
 * - `slug`            for MarkComplete's persistence key.
 * - `readingMinutes`  computed prose reading time (design §1.4).
 * - `headings`        Astro `MarkdownHeading[]` → TableOfContents (h2 only).
 * - `prev` / `next`   adjacent lessons in global order (or null at a boundary).
 * - `prerequisites`   frontmatter `prerequisites`, resolved to titles at build
 *                     time and referentially validated in `[slug].astro`.
 * - `lessons`         every published lesson, forwarded to MarkComplete's
 *                     "N of 15 complete" line.
 *
 * Composes inside BaseLayout's `<main>`. Layout: breadcrumb, header (h1 +
 * summary + meta row + "Builds on:" row), responsive ToC, the 7-section MDX slot
 * (prose capped at --measure, full-column breakout for viz/code/table), and the
 * "What's next" section that closes the loop (completion + prev/next).
 *
 * M8.1 adds the reader's current stage to the meta row — the same `MasteryPips`
 * the curriculum cards use, painted by the second script at the bottom of this
 * file from `src/lib/progress.ts`. It is a derived display of what MarkComplete
 * and PracticeCheck already store: no new key, no new store, and nothing
 * rendered at all when there is nothing recorded.
 */
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import DifficultyChip from '../components/DifficultyChip.astro';
import MasteryPips from '../components/MasteryPips.astro';
import TableOfContents from '../components/TableOfContents.astro';
import WhatsNext from '../components/WhatsNext.astro';
import { courseJsonLd } from '../lib/structured-data';
import type { LessonRef } from '../lib/progress';
import type { Track } from '../lib/tracks';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';

interface Adjacent {
  slug: string;
  title: string;
  /**
   * Human track label, set by `[slug].astro` ONLY when the neighbour lives in a
   * different track (M7.1 IA-5) — `PrevNext` renders it as the "Next track:
   * Algorithms" overline. Absent for the 13 same-track cases, which stay silent.
   */
  trackLabel?: string;
}

/** A prerequisite lesson, resolved from a frontmatter slug at build time. */
interface Prerequisite {
  slug: string;
  title: string;
}

interface Props {
  entry: CollectionEntry<'lessons'>;
  title: string;
  summary: string;
  difficulty: 'beginner' | 'intermediate';
  track: Track;
  estimatedMinutes: number;
  readingMinutes: number;
  slug: string;
  headings: MarkdownHeading[];
  prerequisites: Prerequisite[];
  lessons: LessonRef[];
  prev: Adjacent | null;
  next: Adjacent | null;
}

const {
  entry,
  title,
  summary,
  difficulty,
  track,
  estimatedMinutes,
  readingMinutes,
  slug,
  headings,
  prerequisites,
  lessons,
  prev,
  next,
} = Astro.props;

// Course JSON-LD (arch §3.1). Built at build time and injected via the head slot;
// `is:inline` + `set:html` keeps it static text with zero client JS. `Astro.site`
// is always set (astro.config.mjs), so the non-null assertion is safe.
const jsonLd = courseJsonLd(entry, Astro.site!);
---

<BaseLayout
  title={`${title} · LearnDSA`}
  description={summary}
  canonicalPath={`/learn/${slug}`}
  ogType="article"
>
  <script type="application/ld+json" slot="head" set:html={jsonLd} is:inline />
  <div class="lesson">
    <div class="lesson__grid">
      <article class="lesson__article">
        <Breadcrumb track={track} title={title} />

        <header class="lesson__header">
          <h1>{title}</h1>
          <p class="lesson__summary">{summary}</p>
          <div class="lesson__meta">
            <DifficultyChip difficulty={difficulty} />
            <span aria-hidden="true" class="lesson__dot">·</span>
            <span class="lesson__meta-item">
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="9"></circle>
                <path d="M12 7v5l3 2"></path>
              </svg>
              {estimatedMinutes} min lesson
            </span>
            <span aria-hidden="true" class="lesson__dot">·</span>
            <span class="lesson__meta-item">
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
              </svg>
              {readingMinutes} min read
            </span>

            {
              /* Where this lesson stands, in the one progress currency (M8.1).
                 It rides at the END of the meta row so appearing appends rather
                 than pushing the reading estimates sideways, and the separator
                 lives INSIDE the wrapper so a lesson with nothing recorded
                 never shows a dangling "·". Hidden until the script below
                 resolves a stage — with JS off, or with storage blocked, the
                 header is exactly what M7 rendered. */
            }
            <span class="lesson__stage" data-lesson-stage hidden>
              <span aria-hidden="true" class="lesson__dot">·</span>
              <MasteryPips slug={slug} />
            </span>
          </div>

          {
            prerequisites.length > 0 && (
              <div class="lesson__prereqs">
                <span class="lesson__prereqs-label" id="builds-on">
                  Builds on:
                </span>
                {/* role="list" because `list-style: none` strips list semantics
                    in Safari; same guard /learn uses on its card grid. */}
                <ul
                  class="lesson__prereq-list"
                  role="list"
                  aria-labelledby="builds-on"
                >
                  {prerequisites.map((p) => (
                    <li>
                      <a class="lesson__prereq" href={`/learn/${p.slug}`}>
                        {p.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </header>

        <TableOfContents headings={headings} variant="inline" />

        <hr class="lesson__rule" />

        <div class="lesson-body">
          <slot />
        </div>

        <hr class="lesson__rule lesson__rule--wide" />

        <WhatsNext slug={slug} lessons={lessons} prev={prev} next={next} />
      </article>

      <aside class="lesson__rail">
        <TableOfContents headings={headings} variant="rail" />
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .lesson {
    padding-block-start: var(--space-6);
  }

  @media (min-width: 768px) {
    .lesson {
      padding-block-start: var(--space-10);
    }
  }

  @media (min-width: 1024px) {
    .lesson__grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 15rem;
      column-gap: var(--space-10);
      /* No `align-items: start` here (M7.1 RSP-1): the rail must keep the grid
         default `stretch` so it spans the article's full height. Collapsed to
         its own content height, the `position: sticky` .toc--rail inside it has
         zero travel and scrolls out of view after the first screenful. */
    }
  }

  .lesson__article {
    min-width: 0;
  }

  .lesson__header {
    margin-top: var(--space-4);
  }

  .lesson__header h1 {
    max-width: var(--measure);
  }

  .lesson__summary {
    margin-top: var(--space-3);
    max-width: var(--measure);
    font-size: var(--text-lg);
    color: var(--text-muted);
    line-height: var(--leading-relaxed);
  }

  .lesson__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .lesson__meta-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1-5);
  }

  .lesson__dot {
    color: var(--text-muted);
  }

  /* Its own flex box so the separator sits at the row's gap even though the two
     are one item; `hidden` still wins over this display, because Tailwind's
     preflight hides `[hidden]` with `display: none !important`. */
  .lesson__stage {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
  }

  /* "Builds on:" prerequisites row (M7.2; spec §3 "no dead ends", §8). The
     slugs come from frontmatter and are validated against the published
     collection at build time, so a chip can never point at a dead page. */
  .lesson__prereqs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
    font-size: var(--text-sm);
  }

  .lesson__prereqs-label {
    color: var(--text-muted);
  }

  .lesson__prereq-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lesson__prereq {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding-inline: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    background-color: var(--surface);
    color: var(--text);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    transition: border-color var(--duration-fast) var(--ease-standard);
  }

  .lesson__prereq:hover {
    border-color: var(--brand);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .lesson__rule {
    border: none;
    border-top: 1px solid var(--border);
    margin-block: var(--space-6);
  }

  .lesson__rule--wide {
    margin-block: var(--space-8);
  }

  .lesson__rail {
    display: none;
  }

  @media (min-width: 1024px) {
    .lesson__rail {
      display: block;
    }
  }

  /* ---- Lesson body: prose capped at --measure; viz/code/table break out ---- */
  .lesson-body :global(> *) {
    max-width: var(--measure);
  }

  .lesson-body :global(> .viz),
  .lesson-body :global(> .codetabs),
  .lesson-body :global(> .complexity-table) {
    max-width: 100%;
  }

  /* M7.1 RSP-4: a visualizer wrapped in an anchor/test-hook div (e.g.
     `<div id="viz-binary-search">` in binary-search.mdx) is capped by the
     `> *` measure rule above, and the `> .viz` breakout can't reach through
     the wrapper. Lift the wrapper itself; the inner .viz is then unconstrained
     because only direct children of .lesson-body carry the measure cap. */
  .lesson-body :global(> div:has(> .viz)) {
    max-width: 100%;
  }

  .lesson-body :global(h2) {
    margin-top: var(--space-12);
    margin-bottom: var(--space-4);
  }

  .lesson-body :global(h3) {
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
  }

  /* Where an in-page jump parks a heading: clear of the sticky header always,
     and of the sticky mini-ToC bar too below 1024px (M7.2 — the same reason
     /glossary offsets for its sticky jump bar). Both offsets derive from
     --header-h, replacing the hardcoded 5.5rem that was wrong at <768px where
     the header is 56px. The scroll-spy READS this computed value as its band,
     so the highlighted entry and the jump target can never disagree. */
  .lesson-body :global(h2),
  .lesson-body :global(h3) {
    scroll-margin-top: calc(
      var(--header-h) + var(--toc-bar-h) + var(--space-2)
    );
  }

  @media (min-width: 1024px) {
    .lesson-body :global(h2),
    .lesson-body :global(h3) {
      scroll-margin-top: calc(var(--header-h) + var(--space-6));
    }
  }

  .lesson-body :global(p) {
    margin-block: var(--space-4);
  }

  .lesson-body :global(ul),
  .lesson-body :global(ol) {
    margin-block: var(--space-4);
    padding-left: var(--space-6);
  }

  .lesson-body :global(ul) {
    list-style: disc;
  }

  .lesson-body :global(ol) {
    list-style: decimal;
  }

  .lesson-body :global(li) {
    margin-block: var(--space-2);
  }

  .lesson-body :global(li::marker) {
    color: var(--text-muted);
  }

  .lesson-body :global(a) {
    color: var(--brand);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .lesson-body :global(strong) {
    font-weight: var(--weight-semibold);
    color: var(--text);
  }

  /* Inline code (not inside a Shiki <pre>). Elevation level -1 (M7.3 VD-3):
     global.css assigns "code chrome" to `--surface-sunken`, and after the
     inversion `--surface` is the level-1 CARD fill — a `token` span left on it
     both contradicted the model (code read as raised) and, inside a callout or
     a complexity-table cell, painted exactly the same colour as the box it sits
     in, leaving only the keyline. The `--border` keyline stays because a well
     dropped straight onto the canvas is only 1.08:1 light / 1.06:1 dark and
     needs an edge to exist at all; inside a level-1 card it is 1.12:1 / 1.21:1,
     which is the step the model intends. Text is well clear of AA on the new
     fill: `--text` on `--surface-sunken` is 15.87:1 light / 14.36:1 dark, and
     where the code falls inside a prose link it inherits `--brand` at 5.59:1 /
     5.94:1. */
  .lesson-body :global(:not(pre) > code) {
    background-color: var(--surface-sunken);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.1em 0.35em;
    font-size: 0.9em;
  }

  .lesson-body :global(blockquote) {
    margin-block: var(--space-4);
    padding-left: var(--space-4);
    border-left: 3px solid var(--border);
    color: var(--text-muted);
  }
</style>

<script>
  /**
   * Scroll-spy v2 (M7.2) — progressive enhancement (design §1.3): highlight the
   * ToC entry for the section being read, and name it in the mobile mini-ToC
   * bar. The ToC is fully usable (anchor nav) without any of this.
   *
   * v1 asked an IntersectionObserver for "the first heading inside a narrow
   * band", so on a 7,300px lesson NO entry was current for the ~90% of scroll
   * positions where no heading sits in the band. v2 tracks "the LAST heading
   * whose top has passed the band" against cached offsets, which yields exactly
   * one current entry at every scroll position — above the first heading (it
   * stays current) and at the very bottom of the page alike. Because it reads
   * live scroll positions on every frame, MOT-1's smooth scrolling resolves
   * correctly the whole way and settles on the jumped-to section.
   */
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'),
  );

  // Each heading id maps to all matching ToC links (the inline bar and the rail
  // render the same list), in document order.
  const linksById = new Map<string, HTMLAnchorElement[]>();
  const ids: string[] = [];
  const headings: HTMLElement[] = [];
  for (const link of links) {
    const id = (link.dataset['tocLink'] ?? '').slice(1);
    if (!id) continue;
    const group = linksById.get(id);
    if (group) {
      group.push(link);
      continue;
    }
    const heading = document.getElementById(id);
    if (!heading) continue; // a ToC entry with no heading can never be current
    linksById.set(id, [link]);
    ids.push(id);
    headings.push(heading);
  }

  if (headings.length > 0) {
    const currentLabel =
      document.querySelector<HTMLElement>('[data-toc-current]');
    /** Document-space top of each heading; recomputed whenever layout can change. */
    let tops: number[] = [];
    /** Y offset of the "you are reading here" line, below the sticky chrome. */
    let band = 0;
    let currentId = '';

    function measure(): void {
      const scrollY = window.scrollY;
      tops = headings.map((h) => h.getBoundingClientRect().top + scrollY);
      // The band IS the anchor landing line: `scroll-margin-top` is the CSS
      // that parks a jumped-to heading clear of the header (plus the mini-ToC
      // bar below 1024px), so reading it keeps the spy and in-page jumps in
      // exact agreement at every breakpoint, from one source of truth.
      const first = headings[0];
      band = first
        ? parseFloat(getComputedStyle(first).scrollMarginTop) || 0
        : 0;
    }

    function highlight(): void {
      // +1px of slack: a heading jumped to lands EXACTLY on the band, and
      // fractional scroll positions must not leave it one pixel short.
      const line = window.scrollY + band + 1;
      let id = ids[0];
      for (let i = 0; i < tops.length; i += 1) {
        if (tops[i] <= line) id = ids[i];
        else break;
      }
      if (id === currentId) return;

      const previous = linksById.get(currentId);
      if (previous) {
        for (const link of previous) link.removeAttribute('aria-current');
      }
      const next = linksById.get(id);
      if (next) {
        for (const link of next) link.setAttribute('aria-current', 'location');
        if (currentLabel) {
          currentLabel.textContent = (next[0]?.textContent ?? '').trim();
        }
      }
      currentId = id;
    }

    let queued = false;
    function onScroll(): void {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        highlight();
      });
    }

    measure();
    highlight();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', () => {
      measure();
      highlight();
    });
    // Offsets also move when the page GROWS — a visualizer hydrating from its
    // static frame is the common case — which no resize event reports.
    if ('ResizeObserver' in window) {
      new ResizeObserver(() => {
        measure();
        highlight();
      }).observe(document.body);
    }
  }

  // Collapse the mobile mini-ToC once a section is chosen: the open panel is
  // pinned over the article, so leaving it up would cover the target. Purely an
  // enhancement — with JS off the panel stays open and a tap on the bar closes
  // it, which is native <details> behaviour.
  const inlineToc =
    document.querySelector<HTMLDetailsElement>('[data-toc-inline]');
  inlineToc?.addEventListener('click', (event) => {
    const target = event.target;
    if (target instanceof Element && target.closest('[data-toc-link]')) {
      inlineToc.open = false;
    }
  });

  // Escape dismisses the open panel and hands focus back to the bar that opened
  // it — the expectation any overlaying panel sets, and the only way out for a
  // keyboard user that doesn't mean tabbing through every section link.
  inlineToc?.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !inlineToc.open) return;
    inlineToc.open = false;
    inlineToc.querySelector('summary')?.focus();
  });
</script>

<script>
  /**
   * Lesson header stage (M8.1) — paints the meta row's mastery pips from the
   * shared store, and keeps them true for the rest of the visit.
   *
   * Three kinds of thing can move this row after its first paint, and each is
   * OBSERVED rather than polled: the completion click and a practice self-grade,
   * both caught by the delegated click listener at the bottom; a retrieval pass
   * written by an island that owns no pips (a cleared Final Run, a qualifying
   * predict session), caught by listening on `progress:changed` — the channel
   * `src/lib/progress-events.ts` defines for exactly this, which a writer
   * dispatches once its write has LANDED (the predict session's write sits
   * inside a lazy `import()`, so "landed" is load-bearing); and a
   * back/forward-cache restore, caught by `onRestore`.
   *
   * It reads and never writes: `MarkComplete` owns `lesson:{slug}:complete` and
   * `progress.ts` owns the mastery record, so this is a display of their state
   * (`src/lib/progress.ts` resolves it, `src/lib/mastery-ui.ts` words and draws
   * it — the same two modules /learn's cards use, so a stage cannot mean one
   * thing here and another there).
   *
   * Storage blocked, or nothing recorded: `masteryStage` answers `none` and the
   * row stays hidden — absent, never a wrong stage. With JS off this script
   * never runs and the pips carry their own `<noscript>` kill-switch besides.
   */
  import { masteryStage, onRestore } from '../lib/progress';
  import { PROGRESS_CHANGED_EVENT } from '../lib/progress-events';
  import { paintPips, stageLabel } from '../lib/mastery-ui';

  const wrap = document.querySelector<HTMLElement>('[data-lesson-stage]');
  const pips = wrap?.querySelector<HTMLElement>('[data-mastery-pips]') ?? null;
  // The slug travels ON the component's own hook attribute, not on the layout,
  // so the pips and the record they show can never be given different lessons.
  const slug = pips?.dataset['masteryPips'] ?? '';

  if (wrap && pips && slug) {
    /** Re-reads the store and repaints; silent, and never announces. */
    const paint = (): void => {
      const stage = masteryStage(slug);
      // The device-scope suffix rides in the label because this is a persistent
      // surface far from the controls that carry their own scope line
      // ("Saved only in this browser", "Saved on this device only"), and every
      // one of them owes the reader that sentence.
      paintPips(pips, stage, `${stageLabel(stage)} on this device`);
      wrap.hidden = stage === 'none';
    };

    paint();
    // A back/forward-cache restore replays no script, so a reader returning by
    // Back would otherwise see the stage as it stood when they left.
    onRestore(paint);

    // A write this visit made, announced by the island that made it. Both
    // retrieval passes stamp `practicedAt` from a script that owns no pips, and
    // the predict session's write happens inside a lazy `import()` — no
    // click-time listener could observe THAT, whatever it watched — which is why
    // the channel is an event dispatched after the write, not more delegation.
    document.addEventListener(PROGRESS_CHANGED_EVENT, paint);

    // MarkComplete and PracticeCheck emit nothing, so their acts are still
    // observed the way M8.3's note is specified to: one delegated click
    // listener. The ordering is what makes it correct — both components attach
    // their handlers directly to their own buttons, and a listener on `document`
    // runs in the BUBBLE phase, after the target's own, so the write this click
    // made is already in storage by the time this re-reads it. Kept beside the
    // event rather than replaced by it: a repaint is idempotent and silent
    // (`paintPips` writes one attribute and one label, and this row has no live
    // region), so a component that grows a dispatch later costs a second read
    // and nothing else.
    document.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target : null;
      if (target?.closest('[data-mark-complete], [data-practice-grade]')) {
        paint();
      }
    });
  }
</script>
