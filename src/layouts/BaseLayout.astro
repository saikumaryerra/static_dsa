---
/**
 * BaseLayout — document shell and single head hub for every page (spec §8, §14;
 * M5 architecture §2).
 *
 * Props:
 * - `title`         full document title (pages compose their own, e.g. "Glossary · LearnDSA").
 * - `description`   meta description, also used for Open Graph/Twitter.
 * - `canonicalPath` path for the canonical/OG URL (default: the current pathname).
 * - `ogType`        Open Graph type — 'website' (default) or 'article' (lessons).
 * - `ogImage`       site-relative image path (default `/og-default.png`), resolved
 *                   to an absolute URL via `Astro.site`.
 *
 * This layout owns EVERY head tag from a single source of truth: pages never write
 * their own `<title>`/`<meta>`; they pass props and inject extra head elements
 * (JSON-LD, `noindex`) through the named `head` slot (arch §2.3).
 *
 * Provides: head metadata (description, canonical, full OG/Twitter tags), the
 * pre-paint theme script (designer FOUC spec, verbatim), skip-to-content link,
 * SiteHeader, the `main` landmark wrapping the page slot, and SiteFooter.
 */
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
}

const {
  title,
  description,
  canonicalPath,
  ogType = 'website',
  // SPEC-GAP (arch §5): §14 "OG images" is satisfied dependency-free by one static
  // 1200×630 default; per-page/per-lesson OG generation is deferred (would need a
  // heavy build dep). M7.3 SEO-2 replaced the flat indigo placeholder with a
  // branded card — wordmark, tagline, and a binary-search frame that is the REAL
  // renderer's `renderStatic()` output rather than a redrawing of it (CLAUDE.md:
  // never hand-mock the product). BOTH files are generated: run `npm run og`
  // (scripts/build-og.mjs; manual, deliberately NOT part of `npm run build`) to
  // rewrite public/og-source.svg — the reviewable source — and rasterize it to
  // public/og-default.png. Edit the script, never either output. Pass `ogImage`
  // for any future per-track card.
  ogImage = '/og-default.png',
} = Astro.props;

// Astro.site is set in astro.config.mjs; §14 requires absolute canonical URLs.
// canonicalPath lets pages override the self-referential default (e.g. 404 → "/").
const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* SELF-HOSTED TYPE ("Show Your Work"). Two variable-weight Latin subsets —
        Atkinson Hyperlegible Next (34 KB) and Atkinson Hyperlegible Mono (18 KB),
        both wght 200–800 — served from /fonts and named in tokens.css as
        --font-sans / --font-mono, with the old system stack kept behind each as
        the fallback. They are declared HERE, in the single head hub, and first in
        the head so the preload scanner reaches them before anything else blocks.

        `is:inline`, deliberately: Astro appends its bundled stylesheet link AFTER
        all authored head content (the same ordering the noscript kill-switch at
        the foot of this head depends on), so an @font-face living in that bundle
        would not be parsed until the render-blocking CSS had already arrived —
        and the two preloads above it would have fetched files nothing had yet
        asked for, which is the one thing a preload is supposed to prevent.

        LICENCE: public/fonts/OFL.txt ships alongside the binaries because the SIL
        Open Font License requires its text to travel with the fonts it covers. It
        is a deployment artefact, not a stray file — do not prune it.

        NO METRIC OVERRIDES (no size-adjust / ascent-override / descent-override),
        and that is a decision rather than an omission. An override only helps if
        it is measured against the face the swap is actually coming FROM, and the
        first fallback here is `system-ui`: Segoe UI on Windows, Roboto on
        Android, SF on Apple, whatever fontconfig resolves on Linux. Those have
        different em-relative ascents, so one number tuned to any of them makes
        the reflow worse on the other three. Both faces are preloaded and small,
        so the swap window is short; four invented decimal places would be a guess
        wearing a measurement's clothes. Close this only with per-platform
        fallback metrics in hand. */}
    <link rel="preload" href="/fonts/atkinson-next-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/atkinson-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
    <style is:inline>
      @font-face {
        font-family: 'Atkinson Hyperlegible Next';
        src: url('/fonts/atkinson-next-latin.woff2') format('woff2');
        font-weight: 200 800;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Atkinson Hyperlegible Mono';
        src: url('/fonts/atkinson-mono-latin.woff2') format('woff2');
        font-weight: 200 800;
        font-style: normal;
        font-display: swap;
      }
    </style>
    {/* M7.1 THM-1: browser chrome matches the canvas (--bg per theme). Media-scoped
        so it works with JS off; the first theme-color whose media matches wins, so
        ThemeToggle inserts an un-scoped meta AHEAD of these when the user overrides
        the OS. These two literals are hand-copies of --bg and MUST track it: M7.3
        moved light #FFFFFF → #F8FAFC, and the achromatic repaint now moves the
        pair to #FCFCFB / #101114. ThemeToggle.astro carries the same two literals
        for the override path, so the two files change together — every time.
        JSX-form comment, not an HTML one: Astro emits HTML comments verbatim into
        every built page, so maintainer notes would ship in the head of all 21 of
        them, ahead of the render-blocking CSS. This form is stripped at build. */}
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#FCFCFB" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0E0F12" />
    <!-- Pre-paint theme resolution (designer handoff, byte-verbatim — this file is
         listed in .prettierignore to keep it that way): must run before any content
         paints so the page never flashes the wrong theme. Mirrors
         src/lib/theme.ts#resolveTheme — keep the two in sync. -->
    <script is:inline>
(function () {
  try {
    var t = localStorage.getItem('theme');
    var dark = t ? t === 'dark'
                 : window.matchMedia('(prefers-color-scheme: dark)').matches;
    document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
  } catch (e) { /* no-JS/blocked storage: CSS media-query fallback applies */ }
})();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* M7.1 ICO-1: raster fallbacks for the SVG mark. The 32px PNG is declared
        first so browsers without SVG-favicon support (older Safari) have one they
        can read; SVG-capable browsers still prefer the vector below it. The
        apple-touch-icon is opaque and full-bleed on purpose — iOS composites home
        screen icons on their own squircle mask, so transparent corners would show
        through. Both PNGs are rasterized from public/favicon.svg — regenerate them
        from it, never redraw the mark by hand. */}
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="LearnDSA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <!-- Per-page head injection (JSON-LD, 404 noindex) — arch §2.3. Every meta/OG
         tag above is emitted ONCE from props; pages add head tags only via this slot. -->
    <slot name="head" />
    <!-- Without JS the CSS prefers-color-scheme fallback themes the page, so the
         toggle would be a dead control — hide it (designer spec: no-JS behavior). -->
    <noscript>
      <style>
        /* !important: this <style> sits in <head> BEFORE Astro's injected
           stylesheet link, so the bundle's equal-specificity `.theme-toggle
           { display: inline-flex }` would otherwise win on source order. A
           noscript kill-switch must be unbeatable (QA DEFECT-1). */
        .theme-toggle {
          display: none !important;
        }
      </style>
    </noscript>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <SiteHeader />
    <!-- tabindex=-1: skip-link focus lands IN main, not just scrolls (WCAG 2.4.1). -->
    <main id="main" tabindex="-1" class="mx-auto w-full max-w-container px-4 md:px-6">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
