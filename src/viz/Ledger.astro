---
/**
 * The ledger — the run written out, inside the instrument frame (redesign §7).
 *
 * A `Step` is a row and `Trace = Step[]` is the table; `core/ledger.ts` does the
 * transcription and this file does nothing but render it. The split is the point:
 * the derivation is pure and therefore unit-tested under the harness's
 * `environment: 'node'`, which nothing inside an `.astro` component can be.
 *
 * SERVER-RENDERED ON PURPOSE. With JavaScript disabled the reader gets the
 * complete worked example rather than a still and a dead slider — the one place
 * this redesign makes an invariant STRONGER instead of merely surviving it. It
 * also means the lesson prints as a handout.
 *
 * TABLE SEMANTICS ARE LOAD-BEARING. A `<tr role="button">` stops being a row and
 * takes the column-header association down with it, so the seek control is the
 * step-number cell's own `<button>` inside a `<th scope="row">`. One tab stop is
 * achieved by roving tabindex in the island, not by removing the buttons.
 *
 * The buttons ship `disabled` for the pre-hydration paint and the island enables
 * them — the same pattern the transport row already uses, and the reason a
 * JS-off page shows an inert control rather than a lying one.
 */
import type { Ledger } from './core/ledger';

interface Props {
  ledger: Ledger;
  /** The instrument's id base, so ids stay unique with two visualizers on a page. */
  uid: string;
  /** Algorithm label, for the table's accessible name. */
  label: string;
}

const { ledger, uid, label } = Astro.props;
const { headers, rows } = ledger;
---

<div class="viz-ledger" data-viz-ledger>
  <div class="viz-ledger__well" data-viz-ledger-well>
    <table class="viz-ledger__table" aria-describedby={`${uid}-ledger-cap`}>
      <caption id={`${uid}-ledger-cap`} class="viz-ledger__caption">
        {
          `${label} — the run, written out: ${rows.length} ${rows.length === 1 ? 'step' : 'steps'}`
        }
      </caption>
      <thead>
        <tr>
          <th scope="col" class="viz-ledger__num">#</th>
          {
            headers.map((header) => (
              <th
                scope="col"
                class={
                  header === 'what happened' ? 'viz-ledger__what' : undefined
                }
              >
                {header}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr
              data-ledger-row={row.index}
              aria-current={row.index === 0 ? 'step' : undefined}
            >
              <th scope="row" class="viz-ledger__num">
                <button
                  type="button"
                  class="viz-ledger__seek"
                  data-ledger-seek={row.index}
                  aria-label={`Go to step ${row.n}`}
                  disabled
                >
                  {row.n}
                </button>
              </th>
              {row.cells.map((cell, i) => (
                <td
                  class:list={[
                    headers[i] === 'what happened' && 'viz-ledger__what',
                    cell.numeric && 'viz-ledger__n',
                  ]}
                  data-withheld={cell.withheld ? '' : undefined}
                >
                  {/* A withheld value is ABSENT from the DOM, not dimmed: opacity
                      and colour are defeated by forced-colors mode, by a screen
                      reader reading the accessible name rather than the paint, by
                      select-all, and by print. The `·` is drawn by CSS. */}
                  {cell.withheld ? '' : cell.text}
                </td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</div>

<style>
  .viz-ledger {
    border-top: 1px solid var(--border);
    background: var(--surface-sunken);
  }

  /* Bounded well. Every row stays in the DOM for find-in-page, screen readers
     and print; only the viewport onto them is capped. The island scrolls the
     current row into view, so "where am I" never costs a scroll. */
  .viz-ledger__well {
    max-height: 13.5rem;
    /* BOTH axes, explicitly. A wide run (more columns than a 320px screen has
       room for) must scroll INSIDE the well; the document never scrolls
       sideways. Setting only `overflow-y` computes `overflow-x: auto` anyway,
       which is the right behaviour arrived at by accident — so it is written
       out, and `overscroll-behavior` keeps a flick from escaping to the page. */
    overflow: auto;
    overscroll-behavior: contain;
  }

  @media (max-width: 639px) {
    .viz-ledger__well {
      max-height: 7.5rem;
    }
  }

  .viz-ledger__table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  /* Visually hidden, not display:none — the table keeps its accessible name. */
  .viz-ledger__caption {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .viz-ledger__table th,
  .viz-ledger__table td {
    text-align: left;
    padding: var(--space-1) var(--space-3);
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
    color: var(--text);
    font-weight: var(--weight-normal);
  }

  .viz-ledger__table thead th {
    position: sticky;
    top: 0;
    z-index: 1;
    background: var(--surface-sunken);
    color: var(--text-muted);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: var(--weight-medium);
  }

  .viz-ledger__table tbody tr:last-child th,
  .viz-ledger__table tbody tr:last-child td {
    border-bottom: 0;
  }

  .viz-ledger__num {
    width: 1%;
    padding-inline-start: var(--space-4) !important;
    color: var(--text-muted);
  }

  /* The authored sentence wraps; every other column is a value and does not. */
  .viz-ledger__what {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    white-space: normal;
    min-width: 18ch;
    width: 100%;
  }

  .viz-ledger__seek {
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    padding: 0;
    min-width: 2ch;
    text-align: left;
    cursor: pointer;
  }

  .viz-ledger__seek:disabled {
    cursor: default;
    /* No opacity change: a pre-hydration row number is not an unavailable
       control, it is just a number. The affordance appears with the island. */
  }

  /* The current step. Marked by a rule and a caret AND aria-current — never by
     colour alone, and never by colour at all, since the chrome carries no hue. */
  .viz-ledger__table tbody tr[aria-current='step'] {
    background: var(--surface);
    box-shadow: inset 3px 0 0 var(--text);
  }

  .viz-ledger__table tbody tr[aria-current='step'] th,
  .viz-ledger__table tbody tr[aria-current='step'] td {
    font-weight: var(--weight-semibold);
    color: var(--text);
  }

  .viz-ledger__table tbody tr[aria-current='step'] .viz-ledger__seek::before {
    content: '▶ ';
    font-size: 0.8em;
  }

  /* A withheld cell renders its placeholder in CSS, so the real value is not in
     the DOM at all — see the comment in the markup. */
  .viz-ledger__table td[data-withheld]::after {
    content: '·';
    color: var(--text-muted);
  }

  .viz-ledger__seek:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset);
    border-radius: var(--radius-sm);
  }

  /* Print: the whole run, as a handout. No cap, no sticky header, no scroll. */
  @media print {
    .viz-ledger__well {
      max-height: none;
      overflow: visible;
    }

    .viz-ledger__table thead th {
      position: static;
    }

    .viz-ledger__seek {
      /* A button means nothing on paper; the number still does. */
      color: var(--text);
    }
  }

  @media (forced-colors: active) {
    .viz-ledger__table tbody tr[aria-current='step'] {
      box-shadow: inset 3px 0 0 CanvasText;
    }
  }
</style>
