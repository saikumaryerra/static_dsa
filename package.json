{
  "name": "learndsa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "og": "node --experimental-transform-types scripts/build-og.mjs",
    "icons": "node scripts/build-icons.mjs",
    "fonts": "node scripts/build-fonts.mjs",
    "audit:frames": "node --experimental-transform-types scripts/audit-frames.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "eslint-plugin-astro": "^3.0.1",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}
