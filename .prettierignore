# Designer handoff mandates the token file and the inline FOUC script VERBATIM —
# exempt from reformatting (prettier-plugin-astro reformats embedded scripts even
# behind prettier-ignore comments). Both files are hand-kept in Prettier style
# everywhere outside the verbatim blocks.
src/styles/tokens.css
src/layouts/BaseLayout.astro

# Agent/tooling scratch space, not project source. `.claude/worktrees/` holds a
# full nested checkout of this repo; both are git-excluded already.
.claude/
.impeccable/
# A root-owned leftover from a container e2e run; cannot be removed without a
# root `rm`, and Prettier walks it because only `test-results/` is gitignored.
.test-results-root-owned/

# Build output & generated files
dist/
.astro/
node_modules/
package-lock.json
playwright-report/
test-results/

# Playwright-generated baselines (M7.1 Task 0). Prettier re-indents the nested
# sequences in `.aria.yml`, which would then never match what Playwright writes —
# `format:check` and `test:e2e` would fight forever. Generated, never hand-edited.
tests/e2e/*-snapshots/

# Generated by `npm run fonts` (scripts/build-fonts.mjs), never hand-edited —
# same reason as the Playwright baselines above: the generator writes it, so a
# Prettier pass would make `format:check` and `npm run fonts` disagree forever.
# Its correctness is asserted by tests/unit/font-charset.test.ts, not by its
# indentation.
src/styles/font-charset.ts

# Files owned by the orchestrator / other agents — do not touch
docs/
CLAUDE.md
Agents.md
opencode.json
.opencode/
